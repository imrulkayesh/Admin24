@* Views/Shared/_SideBar.cshtml
   Left menu shell. Menu items still come from the _SideMenuItems partial (unchanged).
   Styles: wwwroot/css/app-standard.css block [8]. *@
<!--begin::Sidebar-->
<aside class="app-sidebar sd-side shadow" data-bs-theme="dark">
    <div class="sidebar-brand">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-link">
            <span class="sd-logo"><i class="fa-solid fa-user-shield"></i></span>
            <span class="brand-text fw-bold">Admin 24/7</span>
        </a>
    </div>


    <div class="sidebar-wrapper">
        <nav class="mt-2">
            <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation"
                aria-label="Main navigation" data-accordion="true" id="navigation">
                <partial name="_SideMenuItems" />
            </ul>
        </nav>
    </div>
</aside>
<!--end::Sidebar-->
@* runs BEFORE the first paint: apply the user's saved open/closed choice (no flash) + menu scroll position.
   The same choice is kept later by block [10] of app-standard.js *@
<script>
    (function () {
        try {
            var b = document.body, desk = window.innerWidth > 992;
            var closed = desk ? localStorage.getItem('sdSidebarCollapsed') === '1' : true;
            b.classList.toggle('sidebar-collapse', closed);
            b.classList.toggle('sidebar-open', !closed);
        } catch (e) { }
        try {
            var v = sessionStorage.getItem('sdSideScroll'), w = document.querySelector('.sidebar-wrapper');
            if (v !== null && w) w.scrollTop = Number(v) || 0;
        } catch (e) { }
    })();
</script>
