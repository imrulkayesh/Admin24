@* Views/Shared/_SideBar.cshtml
   The left menu. Its styles are NOT here any more - they are in wwwroot/css/app-standard.css [2]
   (styles inside the body made the menu flash on every page load). *@
<!--begin::Sidebar-->
<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="light" style="font-size: 0.875rem;">
    <!--begin::Sidebar Brand-->
    <div class="sidebar-brand">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-link">
            <span class="brand-text fw-bold">Admin 24/7</span>
        </a>
    </div>
    <!--end::Sidebar Brand-->
    <!--begin::Sidebar Wrapper-->
    <div class="sidebar-wrapper">
        <nav class="mt-2">
            <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation"
                aria-label="Main navigation" data-accordion="true" id="navigation">
                <partial name="_SideMenuItems" />
            </ul>
        </nav>
    </div>
    <!--end::Sidebar Wrapper-->
</aside>
<!--end::Sidebar-->
@* put the menu back to the scroll position of the last page BEFORE the browser paints (no jump) *@
<script>
    (function () {
        try {
            var v = sessionStorage.getItem('sdSideScroll'), w = document.querySelector('.sidebar-wrapper');
            if (v !== null && w) w.scrollTop = Number(v) || 0;
        } catch (e) { }
    })();
</script>
