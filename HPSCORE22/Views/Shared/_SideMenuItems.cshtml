@* Views/Shared/_SideMenuItems.cshtml
   Draws the sidebar <li> items of the module selected on the Home page (menu tree comes from session "ModuleMenu").
   Used by _SideBar.cshtml.

   Which link is "active"?  the link whose address is the same as the page address OR the start of it, so
   /Meeting/CreateMeeting/15 keeps  /Meeting/CreateMeeting  active.
   A page that is not in the menu (for example ViewMeeting) can say which menu link belongs to it:
        ViewData["MenuPath"] = "/Meeting/MeetingList";                                                  *@
@using System.Text.Json
@using AlphaCare.Models

@functions {
    // old url style "/Pages/Admin/x.aspx" or new "~/Controller/Action" -> app-relative
    string Href(string? url)
    {
        if (string.IsNullOrWhiteSpace(url) || url == "#") return "#";
        if (url.StartsWith("~")) return Url.Content(url);
        if (url.StartsWith("/")) return Url.Content("~" + url);
        return Url.Content("~/" + url);
    }
    string Ico(string? icon, string fallback)
    {
        if (string.IsNullOrWhiteSpace(icon)) return fallback;
        var i = icon.Trim();
        return i.StartsWith("fa ") || i.StartsWith("fa-") ? "fa " + (i.StartsWith("fa ") ? i.Substring(3) : i) : "fa fa-" + i;
    }
}

@{
    int? moduleId = Context.Session.GetInt32("ModuleId");
    string moduleName = Context.Session.GetString("ModuleName") ?? "";
    string moduleIcon = Context.Session.GetString("ModuleIcon") ?? "fa-folder";

    // the page address (or the menu address the page asked for)
    string currentPath = ((ViewData["MenuPath"] as string) ?? Context.Request.Path.Value ?? "").TrimEnd('/');

    bool IsHere(string? url)
    {
        var h = Href(url).TrimEnd('/');
        if (h == "#" || h.Length == 0) return false;
        return currentPath.Equals(h, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(h + "/", StringComparison.OrdinalIgnoreCase);
    }

    var menuJson = Context.Session.GetString("ModuleMenu");
    var tree = string.IsNullOrEmpty(menuJson)
        ? new List<SideMenuItem>()
        : JsonSerializer.Deserialize<List<SideMenuItem>>(menuJson) ?? new List<SideMenuItem>();
}

<li class="nav-item">
    <a asp-controller="Home" asp-action="Index" class="nav-link @(currentPath.Equals(Url.Action("Index", "Home") ?? "", StringComparison.OrdinalIgnoreCase) || currentPath == "" ? "active" : "")">
        <i class="nav-icon fa-solid fa-table-cells-large"></i>
        <p>All Modules</p>
    </a>
</li>

@if (!moduleId.HasValue)
{
    <li class="nav-header">SELECT A MODULE</li>
    @* <li class="side-hint">Click a module on the home page to see its menu here.</li> *@
}
else
{
    <li class="nav-header side-module-head">
        <i class="@Ico(moduleIcon, "fa fa-folder")"></i> @moduleName
    </li>

    @if (tree.Count == 0)
    {
        <li class="side-hint">No menu found for this module.</li>
    }

    @foreach (var parent in tree)
    {
        bool hasKids = parent.Children.Count > 0;
        bool open = parent.Children.Any(k => IsHere(k.Url));

        @if (hasKids)
        {
            <li class="nav-item @(open ? "menu-open" : "")">
                <a href="#" class="nav-link @(open ? "active" : "")">
                    <i class="nav-icon @Ico(parent.Icon, "fa-solid fa-folder-open")"></i>
                    <p>@parent.Title <i class="nav-arrow bi bi-chevron-right"></i></p>
                </a>
                <ul class="nav nav-treeview">
                    @foreach (var child in parent.Children)
                    {
                        <li class="nav-item">
                            <a href="@Href(child.Url)" class="nav-link @(IsHere(child.Url) ? "active" : "")">
                                <i class="nav-icon @Ico(child.Icon, "fa-regular fa-circle")"></i>
                                <p>@child.Title</p>
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a href="@Href(parent.Url)" class="nav-link @(IsHere(parent.Url) ? "active" : "")">
                    <i class="nav-icon @Ico(parent.Icon, "fa-solid fa-link")"></i>
                    <p>@parent.Title</p>
                </a>
            </li>
        }
    }
}
