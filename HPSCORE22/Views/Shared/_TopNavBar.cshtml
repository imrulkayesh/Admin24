@* Views/Shared/_TopNavBar.cshtml
   Top bar: menu button | page title | clock | fullscreen | user chip (User Id) + dropdown | logout.
   Styles are in wwwroot/css/app-standard.css  -> block [8] TOP BAR (see TopSideBar.css). *@
@{
    var userId = Context.Session.GetString("USERID") ?? "";
    var fullName = Context.Session.GetString("UserFullName") ?? Context.Session.GetString("USERNAME") ?? userId;
    var module = Context.Session.GetString("ModuleName") ?? "";
    var initial = string.IsNullOrWhiteSpace(fullName) ? "U" : fullName.Trim().Substring(0, 1).ToUpper();
}
<nav class="app-header navbar navbar-expand bg-body sd-topbar">
    <div class="container-fluid">

        <!-- left -->
        <ul class="navbar-nav align-items-center">
            <li class="nav-item">
                <a class="nav-link sd-iconbtn" data-lte-toggle="sidebar" href="#" role="button" title="Menu">
                    <i class="fa-solid fa-bars"></i>
                </a>
            </li>
            <li class="nav-item d-none d-md-block">
                <a asp-controller="Home" asp-action="Index" class="nav-link sd-iconbtn" title="Home">
                    <i class="fa-solid fa-house"></i>
                </a>
            </li>
            @if (!string.IsNullOrEmpty(module))
            {
                <li class="nav-item d-none d-md-block"><span class="sd-modchip"><i class="fa-solid fa-layer-group"></i> @module</span></li>
            }
        </ul>

        <!-- right -->
        <ul class="navbar-nav ms-auto align-items-center gap-1">
            <li class="nav-item d-none d-lg-block">
                <span class="sd-clock" title="Today"><i class="fa-regular fa-clock"></i> <span id="sdClock">--</span></span>
            </li>
            <li class="nav-item">
                <a class="nav-link sd-iconbtn" href="#" data-lte-toggle="fullscreen" title="Full screen">
                    <i data-lte-icon="maximize" class="fa-solid fa-expand"></i>
                    <i data-lte-icon="minimize" class="fa-solid fa-compress" style="display:none"></i>
                </a>
            </li>

            <!-- user chip: shows the User Id -->
            <li class="nav-item dropdown">
                <a class="nav-link sd-user dropdown-toggle" href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                    <span class="sd-avatar">@initial</span>
                    <span class="sd-user-txt d-none d-sm-flex">
                        <b>@fullName</b>
                        <small><i class="fa-solid fa-id-badge"></i> User Id: @userId</small>
                    </span>
                </a>
                <div class="dropdown-menu dropdown-menu-end sd-usermenu">
                    <div class="sd-usermenu-head">
                        <span class="sd-avatar lg">@initial</span>
                        <div>
                            <div class="fw-bold">@fullName</div>
                            <div class="small opacity-75">User Id : <b>@userId</b></div>
                        </div>
                    </div>
                    <a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-grip"></i> All Modules</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item text-danger" asp-controller="Accounts" asp-action="Logout"><i class="fa-solid fa-right-from-bracket"></i> Sign Out</a>
                </div>
            </li>

            <li class="nav-item">
                <a class="sd-logout" asp-controller="Accounts" asp-action="Logout" title="Log out">
                    <i class="fa-solid fa-power-off"></i><span class="d-none d-md-inline"> Logout</span>
                </a>
            </li>
        </ul>
    </div>
</nav>

<script>
    (function () {                       // small live clock (Dhaka / browser time)
        var el = document.getElementById('sdClock'); if (!el) return;
        function t() {
            var d = new Date();
            el.textContent = d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + '  ' +
                             d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        }
        t(); setInterval(t, 20000);
    })();
</script>
