@* Views/Shared/_Footer.cshtml - matches the top bar / side bar. Styles: block [9] in FooterStyle.css *@
@{
    var fName = Context.Session.GetString("UserFullName") ?? Context.Session.GetString("USERNAME") ?? "";
    var fId = Context.Session.GetString("USERID") ?? "";
}
<!--begin::Footer-->
<footer class="app-footer sd-footer">
    <div class="sd-footer-left">
        <span class="sd-dot"></span>
        <strong>Copyright &copy; @DateTime.Now.Year</strong>
        <a href="#" class="sd-footer-brand">PRG-MIS</a>
        <span class="d-none d-md-inline">· All rights reserved.</span>
    </div>
    @* <div class="sd-footer-user d-none d-md-inline-flex"><i class="fa-solid fa-user"></i> @fName <span>ID: @fId</span></div> *@
    <div class="sd-footer-right d-none d-sm-inline-flex">
        <i class="fa-solid fa-shield-halved"></i> Admin 24/7
    </div>
</footer>
<!--end::Footer-->
