@* Views/Dispatch/ViewDispatch.cshtml  (old YA: Pages/Dispatch/View.aspx + ApproverView.aspx + ApproverViewGlobal.aspx)
   Details of one dispatch: sender, receiver, items, steps (DP_TRANSITS), transport.
   When the dispatch waits for the logged in approver: remarks + Approve / Reject / Save remarks + delete item (old ApproverView).
   When it waits at the user's dispatch desk (phase 3): "send" -> Add Transport + Send (old DispatchView.aspx),
   "receive" -> Receive (old Details.aspx, status 3 / 7). *@
@model AlphaCare.Models.DispatchDetailsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var d = Model.Dispatch;
    ViewData["Title"] = "Dispatch " + d.TRANSACTIONID;
}

<style>
    .dv-box { border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px 16px; height: 100%; background: #fff; }
    .dv-box h6 { font-weight: 700; color: #334155; margin-bottom: 10px; }
    .dv-box h6 i { color: #4f46e5; }
    .dv-row { display: flex; gap: 8px; padding: 3px 0; }
    .dv-row b { min-width: 110px; color: #475569; font-weight: 600; }
    .dv-active { background: #fef9c3; }
</style>

<div class="container-fluid py-3" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="mb-0"><i class="fas fa-file-lines me-2"></i>Dispatch <span class="fw-bold">@d.TRANSACTIONID</span></h5>
            <button type="button" class="btn btn-sm btn-light" onclick="history.length > 1 ? history.back() : location.href='@Url.Action("CreateDispatch", "Dispatch")'">
                <i class="fas fa-arrow-left me-1"></i>Back
            </button>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-3">
                <div class="col-lg-4">
                    <div class="dv-box">
                        <h6><i class="fas fa-circle-info me-2"></i>Dispatch</h6>
                        <div class="dv-row"><b>Dispatch ID</b><span>@d.TRANSACTIONID</span></div>
                        <div class="dv-row"><b>Date</b><span>@(d.CREATEDATE?.ToString("dd/MM/yyyy hh:mm tt") ?? "-")</span></div>
                        <div class="dv-row"><b>Issue Type</b><span>@d.ISSUETYPENAME</span></div>
                        <div class="dv-row"><b>Direct Send</b><span>@(d.DIRECTSEND == 1 ? "Yes" : "No")</span></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="dv-box">
                        <h6><i class="fas fa-user-tag me-2"></i>Sender</h6>
                        <div class="dv-row"><b>Name</b><span>@d.EMPLOYEENAME</span></div>
                        <div class="dv-row"><b>Department</b><span>@d.DEPARTMENTCODE</span></div>
                        <div class="dv-row"><b>Location</b><span>@d.CENTERCODE-@d.SENDERADDRESS</span></div>
                        <div class="dv-row"><b>Mobile</b><span>@d.OFFICEMOBILE</span></div>
                    </div>
                </div>
                @if (Model.ShowReceiver)
                {
                    <div class="col-lg-4">
                        <div class="dv-box">
                            <h6><i class="fas fa-user-check me-2"></i>Receiver</h6>
                            <div class="dv-row"><b>Name</b><span>@d.RECEIVERNAME</span></div>
                            <div class="dv-row"><b>Department</b><span>@d.RECEIVERDEPARTMENT</span></div>
                            <div class="dv-row"><b>Location</b><span>@Model.ReceiverLocation</span></div>
                            <div class="dv-row"><b>Mobile</b><span>@d.RECEIVERMOBILE</span></div>
                        </div>
                    </div>
                }
            </div>

            <!-- items -->
            <div class="dv-box mb-3">
                <h6><i class="fas fa-boxes-stacked me-2"></i>Items</h6>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Item</th><th>Quantity</th><th>Unit</th><th>Notes</th><th>Attachment</th>@if (Model.CanApprove){<th></th>}</tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Items)
                            {
                                <tr data-id="@i.ID" data-title="@i.ITEMNAME">
                                    <td>@i.ITEMNAME</td>
                                    <td>@(i.QUANTITY?.ToString("0.##"))</td>
                                    <td>@i.UNIT</td>
                                    <td>@i.NOTES</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(i.ATTACHMENT))
                                        {
                                            <a href="@Url.Action("Attachment", "Dispatch", new { id = i.ID })" target="_blank" rel="noopener"><i class="fas fa-paperclip me-1"></i>@i.ATTACHMENT</a>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    @if (Model.CanApprove)
                                    {
                                        <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger dv-del" title="Delete item"><i class="fas fa-trash"></i></button></td>
                                    }
                                </tr>
                            }
                            @if (Model.Items.Count == 0)
                            {
                                <tr><td colspan="6" class="text-muted">No item.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- steps (DP_TRANSITS) -->
            <div class="dv-box mb-3">
                <h6><i class="fas fa-route me-2"></i>Steps</h6>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Step</th><th>By</th><th>Received</th><th>Released</th><th>Remarks</th></tr></thead>
                        <tbody>
                            @foreach (var t in Model.Transits)
                            {
                                <tr class="@(t.ISACTIVE == 1 ? "dv-active" : "")">
                                    <td>@t.STEP @if (t.ISACTIVE == 1){<span class="badge bg-warning text-dark ms-1">Current</span>}</td>
                                    <td>@(string.IsNullOrWhiteSpace(t.EMPLOYEENAME) ? (t.UPDATEDBY ?? "-") : t.EMPLOYEENAME)</td>
                                    <td class="text-nowrap">@(t.RECEIVEDATE?.ToString("dd/MM/yyyy hh:mm tt") ?? "-")</td>
                                    <td class="text-nowrap">@(t.RELEASEDATE?.ToString("dd/MM/yyyy hh:mm tt") ?? "-")</td>
                                    <td>@t.REMARKS</td>
                                </tr>
                            }
                            @if (Model.Transits.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted">No step yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.Transports.Count > 0)
            {
                <div class="dv-box mb-3">
                    <h6><i class="fas fa-truck me-2"></i>Transport</h6>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light"><tr><th>Transport</th><th>Driver</th><th>Delivery Man</th><th>Mobile</th><th>Cost</th></tr></thead>
                            <tbody>
                                @foreach (var t in Model.Transports)
                                {
                                    <tr><td>@t.TRANSPORTNAME</td><td>@t.DRIVER</td><td>@t.DELIVERYMAN</td><td>@t.MOBILE</td><td>@t.COST @t.CURRENCYCODE</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (Model.CanApprove)
            {
                <!-- old ApproverView: remarks + Approve / Reject / Save -->
                <div class="dv-box">
                    <h6><i class="fas fa-user-check me-2"></i>Approval</h6>
                    <label for="dvRemarks" class="form-label fw-semibold">Remarks</label>
                    <textarea id="dvRemarks" class="form-control mb-2" rows="2" maxlength="100"></textarea>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-success" data-act="approve"><i class="fas fa-check me-1"></i>Approve</button>
                        <button type="button" class="btn btn-danger" data-act="reject"><i class="fas fa-xmark me-1"></i>Reject</button>
                        <button type="button" class="btn btn-outline-primary" data-act="save"><i class="fas fa-floppy-disk me-1"></i>Save remarks</button>
                    </div>
                </div>
            }

            @if (Model.MyAction != null)
            {
                <!-- old ReceiverView.aspx (Receive + Update) / ReturnView.aspx (Return + Direct Return + Update) -->
                <div class="dv-box mb-3">
                    <h6><i class="fas fa-hand-holding me-2"></i>@(Model.MyAction == "receive" ? "Receive" : "Return")</h6>
                    <label for="myRemarks" class="form-label fw-semibold">Remarks</label>
                    <textarea id="myRemarks" class="form-control mb-2" rows="2" maxlength="100" placeholder="Please write your comments.."></textarea>
                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.MyAction == "receive")
                        {
                            <button type="button" class="btn btn-success" data-my="receive"><i class="fas fa-check me-1"></i>Receive</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-success" data-my="return"><i class="fas fa-arrow-rotate-left me-1"></i>Return</button>
                            <button type="button" class="btn btn-outline-success" data-my="direct"><i class="fas fa-reply me-1"></i>Direct Return</button>
                        }
                        <button type="button" class="btn btn-outline-primary" data-my="save"><i class="fas fa-floppy-disk me-1"></i>Update remarks</button>
                    </div>
                </div>
            }

            @if (Model.DeskAction == "send")
            {
                <!-- old DispatchView.aspx (from the desk "Waiting to Send"): transport details + remarks + Send / Update -->
                <form class="dv-box mb-3" id="dkTransport" autocomplete="off">
                    <h6><i class="fas fa-truck-ramp-box me-2"></i>Add Transport</h6>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label for="dkTr" class="form-label fw-semibold">Transport <span class="text-danger">*</span></label>
                            <select id="dkTr" class="form-select">
                                <option value="0">-- Select --</option>
                                @foreach (var t in Model.TransportTypes)
                                {
                                    <option value="@t.ID">@t.TRANSPORTNAME</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label for="dkCost" class="form-label fw-semibold">Transport Cost</label>
                            <input type="number" id="dkCost" class="form-control" min="0" step="1" value="0" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label for="dkCur" class="form-label fw-semibold">Currency <span class="text-danger">*</span></label>
                            <select id="dkCur" class="form-select">
                                @foreach (var c in Model.Currencies)
                                {
                                    <option value="@c.ID">@c.CURRENCYNAME@(string.IsNullOrWhiteSpace(c.CURRENCYCODE) ? "" : " (" + c.CURRENCYCODE + ")")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="dkDriver" class="form-label fw-semibold">Driver</label>
                            <input type="text" id="dkDriver" class="form-control" maxlength="120" placeholder="Enter Driver Name" />
                        </div>
                        <div class="col-md-4">
                            <label for="dkMan" class="form-label fw-semibold">Delivery Man</label>
                            <input type="text" id="dkMan" class="form-control" maxlength="120" placeholder="Enter Delivery Man" />
                        </div>
                        <div class="col-md-4">
                            <label for="dkMobile" class="form-label fw-semibold">Mobile</label>
                            <input type="text" id="dkMobile" class="form-control" maxlength="50" placeholder="Enter Mobile" />
                        </div>
                    </div>
                    <div class="text-end mt-2">
                        <button type="submit" class="btn btn-outline-primary"><i class="fas fa-plus me-1"></i>Save Transport</button>
                    </div>
                </form>
            }

            @if (Model.DeskAction != null)
            {
                <!-- old btnSaveandSend ("Send" on DispatchView.aspx / "Receive" on Details.aspx) + btnSave (remarks only) -->
                <div class="dv-box">
                    <h6><i class="fas fa-building-flag me-2"></i>Dispatch Desk</h6>
                    <label for="dkRemarks" class="form-label fw-semibold">Remarks</label>
                    <textarea id="dkRemarks" class="form-control mb-2" rows="2" maxlength="100" placeholder="Please write your comments.."></textarea>
                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.DeskAction == "send")
                        {
                            <button type="button" class="btn btn-success" data-desk="send"><i class="fas fa-paper-plane me-1"></i>Send</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-success" data-desk="receive"><i class="fas fa-check me-1"></i>Receive</button>
                        }
                        <button type="button" class="btn btn-outline-primary" data-desk="save"><i class="fas fa-floppy-disk me-1"></i>Update remarks</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.CanApprove)
    {
        <script>
            (function () {
                var id = '@d.ID', title = '@d.TRANSACTIONID';
                var back = '@Url.Action("Approval", "Dispatch")';
                var U = { approve: '@Url.Action("Approve", "Dispatch")', reject: '@Url.Action("Reject", "Dispatch")',
                          save: '@Url.Action("SaveRemarks", "Dispatch")', del: '@Url.Action("DeleteItemByApprover", "Dispatch")' };

                document.querySelectorAll('[data-act]').forEach(function (b) {
                    b.addEventListener('click', function () {
                        var act = b.dataset.act, remarks = document.getElementById('dvRemarks').value.trim();
                        if (act === 'save') {
                            SD.post(U.save, { id: id, remarks: remarks }).then(function (res) { SD.toast(res.message, !res.success); })
                                .catch(function () { SD.toast('Server error. Please try again.', true); });
                            return;
                        }
                        var ok = act === 'approve';
                        SD.confirm({
                            title: ok ? 'Approve this dispatch?' : 'Reject this dispatch?', text: title,
                            tone: ok ? 'success' : 'danger', icon: ok ? 'fa-check' : 'fa-xmark', yesText: ok ? 'Approve' : 'Reject',
                            run: function () { return SD.post(ok ? U.approve : U.reject, { id: id, remarks: remarks }); }
                        }).then(function (res) {
                            if (res && res.success) { SD.toast(res.message); setTimeout(function () { location.href = back; }, 900); }
                        });
                    });
                });

                document.querySelectorAll('.dv-del').forEach(function (b) {
                    b.addEventListener('click', function () {
                        var tr = b.closest('tr');
                        SD.confirm({
                            title: 'Delete this item from the dispatch?', text: tr.dataset.title, tone: 'danger', icon: 'fa-trash', yesText: 'Delete',
                            run: function () { return SD.post(U.del, { id: tr.dataset.id }); }
                        }).then(function (res) { if (res && res.success) { SD.toast(res.message); setTimeout(function () { location.reload(); }, 700); } });
                    });
                });
            })();
        </script>
    }
    @if (Model.MyAction != null)
    {
        <script>
            (function () {
                var id = '@d.ID', title = '@d.TRANSACTIONID', back = '@Url.Action("Receive", "Dispatch")';
                var U = { receive: '@Url.Action("MyReceive", "Dispatch")', ret: '@Url.Action("ReturnDispatch", "Dispatch")', save: '@Url.Action("MyRemarks", "Dispatch")' };

                document.querySelectorAll('[data-my]').forEach(function (b) {
                    b.addEventListener('click', function () {
                        var act = b.dataset.my, remarks = document.getElementById('myRemarks').value.trim();
                        if (act === 'save') {
                            SD.post(U.save, { id: id, remarks: remarks }).then(function (res) { SD.toast(res.message, !res.success); })
                                .catch(function () { SD.toast('Server error. Please try again.', true); });
                            return;
                        }
                        var o = {
                            receive: { t: 'Receive this dispatch?', y: 'Receive', i: 'fa-check', run: function () { return SD.post(U.receive, { id: id, remarks: remarks }); } },
                            'return': { t: 'Return this dispatch through the dispatch desks?', y: 'Return', i: 'fa-arrow-rotate-left', run: function () { return SD.post(U.ret, { id: id, direct: 0, remarks: remarks }); } },
                            direct: { t: 'Direct return this dispatch?', y: 'Direct Return', i: 'fa-reply', run: function () { return SD.post(U.ret, { id: id, direct: 1, remarks: remarks }); } }
                        }[act];
                        SD.confirm({ title: o.t, text: title, tone: 'success', icon: o.i, yesText: o.y, run: o.run })
                            .then(function (res) { if (res && res.success) { SD.toast(res.message); setTimeout(function () { location.href = back; }, 1200); } });
                    });
                });
            })();
        </script>
    }
    @if (Model.DeskAction != null)
    {
        <script>
            (function () {
                var id = '@d.ID', title = '@d.TRANSACTIONID', back = '@Url.Action("DispatchDesk", "Dispatch")';
                var U = { send: '@Url.Action("DeskSend", "Dispatch")', receive: '@Url.Action("DeskReceive", "Dispatch")',
                          save: '@Url.Action("DeskRemarks", "Dispatch")', transport: '@Url.Action("AddTransport", "Dispatch")' };
                var val = function (x) { var e = document.getElementById(x); return e ? e.value.trim() : ''; };

                document.querySelectorAll('[data-desk]').forEach(function (b) {
                    b.addEventListener('click', function () {
                        var act = b.dataset.desk, remarks = val('dkRemarks');
                        if (act === 'save') {
                            SD.post(U.save, { id: id, remarks: remarks }).then(function (res) { SD.toast(res.message, !res.success); })
                                .catch(function () { SD.toast('Server error. Please try again.', true); });
                            return;
                        }
                        var send = act === 'send';
                        SD.confirm({
                            title: send ? 'Send this dispatch?' : 'Receive this dispatch?', text: title,
                            tone: 'success', icon: send ? 'fa-paper-plane' : 'fa-check', yesText: send ? 'Send' : 'Receive',
                            run: function () { return SD.post(send ? U.send : U.receive, { id: id, remarks: remarks }); }
                        }).then(function (res) {
                            if (res && res.success) { SD.toast(res.message); setTimeout(function () { location.href = back; }, 1200); }
                        });
                    });
                });

                var tf = document.getElementById('dkTransport');
                if (tf) tf.addEventListener('submit', function (e) {
                    e.preventDefault();
                    if (val('dkTr') === '0') { SD.toast('Select the Transport.', true); return; }
                    SD.post(U.transport, {
                        id: id, transportId: val('dkTr'), currencyId: val('dkCur'), cost: val('dkCost'),
                        driver: val('dkDriver'), deliveryMan: val('dkMan'), mobile: val('dkMobile')
                    }).then(function (res) {
                        SD.toast(res.message, !res.success);
                        if (res.success) setTimeout(function () { location.reload(); }, 700);     // shows the new row in "Transport"
                    }).catch(function () { SD.toast('Server error. Please try again.', true); });
                });
            })();
        </script>
    }
}
