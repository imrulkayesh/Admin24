@* Views/Dispatch/Status.cshtml  (old YA: Pages/Dispatch/Status.aspx)
   Setup of DP_STATUS names (used as labels in reports: DP_DISPATCH.STATUSID = DP_STATUS.ID). Add / edit, no delete (switched off in YA). *@
@model List<AlphaCare.Models.StatusSetupModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dispatch Status";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-signal me-2"></i>Dispatch Status</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 align-items-end mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                <div class="col-md-5">
                    <label for="fName" class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
                    <input type="text" id="fName" class="form-control" maxlength="50" placeholder="Enter Status" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Refresh</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search status..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="id">ID<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="name">Status<i class="fas fa-sort arr"></i></th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var s in Model)
                            {
                                <tr data-search="@((s.STATUSNAME ?? "").ToLower()) @s.ID" data-i="@(idx++)" data-k-id="@s.ID.ToString("D6")" data-k-name="@((s.STATUSNAME ?? "").ToLower())"
                                    data-id="@s.ID" data-name="@s.STATUSNAME">
                                    <td data-label="ID"><div class="sd-cell">@s.ID</div></td>
                                    <td data-label="Status"><div class="sd-cell">@s.STATUSNAME</div></td>
                                    <td class="text-center" data-label="Action"><div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No status yet.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No status matched your filter.</div>
            </div>
            <div class="small text-muted mt-2">The ID is the status number the dispatch flow uses. Renaming changes only the label shown in reports.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var $ = function (id) { return document.getElementById(id); };
            function reset() { $('fId').value = '0'; $('fName').value = ''; $('fSaveText').textContent = 'Save'; }
            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var d = b.closest('tr').dataset;
                    $('fId').value = d.id; $('fName').value = d.name || ''; $('fSaveText').textContent = 'Update';
                    $('fName').focus(); window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            $('fReset').addEventListener('click', reset);
            $('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                if (!$('fName').value.trim()) { SD.toast('Enter Status', true); return; }
                SD.post('@Url.Action("SaveStatus", "Dispatch")', { id: $('fId').value, name: $('fName').value.trim() })
                    .then(function (res) { SD.toast(res.message, !res.success); if (res.success) setTimeout(function () { location.reload(); }, 800); })
                    .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
