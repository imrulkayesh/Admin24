@* Views/Dispatch/Steps.cshtml  (old YA: Pages/Dispatch/Steps.aspx)
   Setup of DP_STEPS (step name, priority, issue type, final step). Add / edit, no delete (switched off in YA).
   Note: the dispatch flow builds its step names in code (old DispatchStatus); this table is reference data only. *@
@model AlphaCare.Models.StepSetupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dispatch Steps";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-shoe-prints me-2"></i>Dispatch Steps</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 align-items-end mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                <div class="col-md-4">
                    <label for="fName" class="form-label fw-semibold">Step <span class="text-danger">*</span></label>
                    <input type="text" id="fName" class="form-control" maxlength="150" placeholder="Enter Step" />
                </div>
                <div class="col-6 col-md-2">
                    <label for="fPri" class="form-label fw-semibold">Priority <span class="text-danger">*</span></label>
                    <input type="number" id="fPri" class="form-control" min="1" max="999" step="1" value="1" />
                </div>
                <div class="col-6 col-md-3">
                    <label for="fType" class="form-label fw-semibold">Issue Type <span class="text-danger">*</span></label>
                    <select id="fType" class="form-select">
                        <option value="0">-- Select --</option>
                        @foreach (var t in Model.IssueTypes)
                        {
                            <option value="@t.ID">@t.ISSUETYPENAME</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="fFinal" /><label class="form-check-label fw-semibold" for="fFinal">Is Final Step</label></div>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Refresh</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search step, issue type..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="name">Step<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="pri">Priority<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="type">Issue Type<i class="fas fa-sort arr"></i></th>
                                <th>Final Step</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var s in Model.Rows)
                            {
                                <tr data-search="@($"{s.STEPNAME} {s.ISSUETYPENAME}".ToLower())" data-i="@(idx++)"
                                    data-k-name="@((s.STEPNAME ?? "").ToLower())" data-k-pri="@((s.PRIORITY ?? 0).ToString("D6"))" data-k-type="@((s.ISSUETYPENAME ?? "").ToLower())"
                                    data-id="@s.ID" data-name="@s.STEPNAME" data-pri="@s.PRIORITY" data-type="@s.ISSUETYPEID" data-final="@(s.ISFINALSTEP ?? 0)">
                                    <td data-label="Step"><div class="sd-cell">@s.STEPNAME</div></td>
                                    <td data-label="Priority"><div class="sd-cell">@s.PRIORITY</div></td>
                                    <td data-label="Issue Type"><div class="sd-cell">@(s.ISSUETYPENAME ?? "-")</div></td>
                                    <td data-label="Final Step"><div class="sd-cell">@(s.ISFINALSTEP == 1 ? "Yes" : "No")</div></td>
                                    <td class="text-center" data-label="Action"><div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Rows.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No step yet.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No step matched your filter.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var $ = function (id) { return document.getElementById(id); };
            function reset() { $('fId').value = '0'; $('fName').value = ''; $('fPri').value = '1'; $('fType').value = '0'; $('fFinal').checked = false; $('fSaveText').textContent = 'Save'; }
            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var d = b.closest('tr').dataset;
                    $('fId').value = d.id; $('fName').value = d.name || ''; $('fPri').value = d.pri || '1';
                    $('fType').value = d.type || '0'; $('fFinal').checked = d.final === '1'; $('fSaveText').textContent = 'Update';
                    $('fName').focus(); window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            $('fReset').addEventListener('click', reset);
            $('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                SD.post('@Url.Action("SaveStep", "Dispatch")', {
                    id: $('fId').value, name: $('fName').value.trim(), priority: $('fPri').value, issueTypeId: $('fType').value, isFinal: $('fFinal').checked
                }).then(function (res) { SD.toast(res.message, !res.success); if (res.success) setTimeout(function () { location.reload(); }, 800); })
                  .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
