@* Views/Dispatch/IssueType.cshtml  (old YA: Pages/Dispatch/IssueType.aspx)
   Setup of DP_ISSUETYPE: add / edit (name + Returnable / External / Personal). No delete (switched off in YA).
   The flags decide the receiver part of Create Dispatch and the flow (personal = no transport, returnable = can come back). *@
@model List<AlphaCare.Models.IssueTypeSetupModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Issue Type";
    Func<int, string> yn = v => v == 1 ? "Yes" : "No";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-tags me-2"></i>Issue Type</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 align-items-end mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                <div class="col-md-4">
                    <label for="fName" class="form-label fw-semibold">Issue Type <span class="text-danger">*</span></label>
                    <input type="text" id="fName" class="form-control" maxlength="50" placeholder="Enter Issue Type" />
                </div>
                <div class="col-md-4 d-flex flex-wrap gap-3 pb-2">
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="fRet" /><label class="form-check-label" for="fRet">Returnable</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="fExt" /><label class="form-check-label" for="fExt">External</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="fPer" /><label class="form-check-label" for="fPer">Personal</label></div>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Refresh</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search issue type..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="name">Issue Type<i class="fas fa-sort arr"></i></th>
                                <th>Returnable</th>
                                <th>External</th>
                                <th>Personal</th>
                                <th>Active</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var t in Model)
                            {
                                <tr data-search="@((t.ISSUETYPENAME ?? "").ToLower())" data-i="@(idx++)" data-k-name="@((t.ISSUETYPENAME ?? "").ToLower())"
                                    data-id="@t.ID" data-name="@t.ISSUETYPENAME" data-ret="@t.RETURNABLE" data-ext="@t.ISEXTERNAL" data-per="@t.ISPERSONAL">
                                    <td data-label="Issue Type"><div class="sd-cell">@t.ISSUETYPENAME</div></td>
                                    <td data-label="Returnable"><div class="sd-cell">@yn(t.RETURNABLE)</div></td>
                                    <td data-label="External"><div class="sd-cell">@yn(t.ISEXTERNAL)</div></td>
                                    <td data-label="Personal"><div class="sd-cell">@yn(t.ISPERSONAL)</div></td>
                                    <td data-label="Active"><div class="sd-cell">@yn(t.ISACTIVE)</div></td>
                                    <td class="text-center" data-label="Action"><div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No issue type yet.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No issue type matched your filter.</div>
            </div>
            <div class="small text-muted mt-2">Only active issue types are offered on Create Dispatch.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var $ = function (id) { return document.getElementById(id); };
            function reset() { $('fId').value = '0'; $('fName').value = ''; $('fRet').checked = $('fExt').checked = $('fPer').checked = false; $('fSaveText').textContent = 'Save'; }

            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var d = b.closest('tr').dataset;
                    $('fId').value = d.id; $('fName').value = d.name || '';
                    $('fRet').checked = d.ret === '1'; $('fExt').checked = d.ext === '1'; $('fPer').checked = d.per === '1';
                    $('fSaveText').textContent = 'Update'; $('fName').focus(); window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            $('fReset').addEventListener('click', reset);
            $('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                if (!$('fName').value.trim()) { SD.toast('Enter Issue Type', true); return; }
                SD.post('@Url.Action("SaveIssueType", "Dispatch")', {
                    id: $('fId').value, name: $('fName').value.trim(), returnable: $('fRet').checked, external: $('fExt').checked, personal: $('fPer').checked
                }).then(function (res) { SD.toast(res.message, !res.success); if (res.success) setTimeout(function () { location.reload(); }, 800); })
                  .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
