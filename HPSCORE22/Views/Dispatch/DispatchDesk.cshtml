@* Views/Dispatch/DispatchDesk.cshtml  (old YA: Pages/Dispatch/DispatchDesk.aspx)
   LIST PAGE - standard look (app-standard.css / app-standard.js: SD.initList, SD.confirm, SD.post).
   Scan box (old tbxSearchDispatch): writes a "<my location>-Dispatch / Received" line on the dispatch (old InsertReceive).
   Tabs: Waiting to Send (view -> transport + Send) | Waiting to Receive (Receive at once, or view -> remarks + Receive). *@
@model AlphaCare.Models.DispatchDeskViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dispatch Desk";

    var sections = new[]
    {
        (Id: "send",    Title: "Waiting to Send",    Icon: "fa-truck-fast",  Color: "#dc2626", Rows: Model.ToSend),
        (Id: "receive", Title: "Waiting to Receive", Icon: "fa-inbox",       Color: "#2563eb", Rows: Model.ToReceive)
    };
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">

        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-building-flag me-2"></i>Dispatch Desk</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <!-- old tbxSearchDispatch + btnSearch (a barcode scanner types the id and Enter) -->
            <form id="scanForm" class="mb-3" autocomplete="off">
                <label for="scanTx" class="form-label fw-semibold mb-1"><i class="fas fa-barcode me-1"></i>Receive by scan</label>
                <div class="input-group" style="max-width:520px">
                    <input type="text" id="scanTx" class="form-control" maxlength="50" placeholder="Enter Transaction ID" autofocus />
                    <button type="submit" class="btn btn-primary"><i class="fas fa-magnifying-glass me-1"></i>Search</button>
                </div>
                <div class="small text-muted mt-1">Adds a "Received" line for your location to the dispatch. It does not change the status.</div>
            </form>

            <div class="sd-tabs mb-3">
                @for (int i = 0; i < sections.Length; i++)
                {
                    var sec = sections[i];
                    <button type="button" class="sd-tab @(i == 0 ? "active" : "")" data-pane="@sec.Id" style="--c:@sec.Color">
                        <i class="fas @sec.Icon"></i> @sec.Title <span class="cnt">@sec.Rows.Count</span>
                    </button>
                }
            </div>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search dispatch id, sender, receiver, mobile, location..." autocomplete="off" />
                </div>
                <div class="input-group" style="max-width:210px">
                    <span class="input-group-text bg-white"><i class="far fa-calendar text-muted"></i></span>
                    <input type="date" class="form-control" id="sdDate" title="Show one date only" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            @for (int s = 0; s < sections.Length; s++)
            {
                var sec = sections[s];
                <div class="sd-pane @(s == 0 ? "active" : "")" id="pane-@sec.Id">
                    <div class="sd-wrap table-responsive">
                        <table class="sd-table">
                            <thead>
                                <tr>
                                    <th class="text-center">Action</th>
                                    <th class="sortable" data-sort="tx">Dispatch ID<i class="fas fa-sort arr"></i></th>
                                    <th class="sortable" data-sort="date">Date<i class="fas fa-sort arr"></i></th>
                                    <th class="sortable" data-sort="sender">Sender<i class="fas fa-sort arr"></i></th>
                                    <th class="sortable" data-sort="rec">Receiver<i class="fas fa-sort arr"></i></th>
                                    <th>Mobile</th>
                                    <th>Location</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int idx = 0;
                                }
                                @foreach (var r in sec.Rows)
                                {
                                    string place = $"{r.RECEIVERDEPARTMENT}-{r.BUSINESSCENTER}" + (string.IsNullOrWhiteSpace(r.RECEIVERADDRESS) ? "" : ". " + r.RECEIVERADDRESS);
                                    string search = $"{r.TRANSACTIONID} {r.ISSUETYPENAME} {r.EMPLOYEENAME} {r.RECEIVERNAME} {r.RECEIVERMOBILE} {place}".ToLower();
                                    <tr data-search="@search" data-id="@r.ID" data-title="@r.TRANSACTIONID" data-i="@(idx++)"
                                        data-date="@(r.CREATEDATE?.ToString("yyyy-MM-dd"))"
                                        data-k-tx="@((r.TRANSACTIONID ?? "").ToLower())" data-k-date="@(r.CREATEDATE?.Ticks ?? 0)"
                                        data-k-sender="@((r.EMPLOYEENAME ?? "").ToLower())" data-k-rec="@((r.RECEIVERNAME ?? "").ToLower())">

                                        <td class="text-center text-nowrap" data-label="Action">
                                            <div class="sd-cell">
                                                @if (sec.Id == "receive")
                                                {
                                                    <button type="button" class="sd-btn ok" title="Receive" data-act="receive"><i class="fas fa-check"></i></button>
                                                }
                                                <a class="sd-btn" title="@(sec.Id == "send" ? "Open: transport + Send" : "View Details")" href="@Url.Action("ViewDispatch", "Dispatch", new { id = r.ID })">
                                                    <i class="fas @(sec.Id == "send" ? "fa-truck" : "fa-eye")"></i>
                                                </a>
                                            </div>
                                        </td>
                                        <td data-label="Dispatch ID" class="text-nowrap"><div class="sd-cell"><a class="sd-title" href="@Url.Action("ViewDispatch", "Dispatch", new { id = r.ID })">@r.TRANSACTIONID</a></div></td>
                                        <td data-label="Date" class="text-nowrap"><div class="sd-cell">@(r.CREATEDATE?.ToString("dd/MM/yyyy hh:mm tt") ?? "-")</div></td>
                                        <td data-label="Sender"><div class="sd-cell">@r.EMPLOYEENAME</div></td>
                                        <td data-label="Receiver"><div class="sd-cell">@(string.IsNullOrWhiteSpace(r.RECEIVERNAME) ? "-" : r.RECEIVERNAME)</div></td>
                                        <td data-label="Mobile" class="text-nowrap">
                                            <div class="sd-cell">
                                                @if (!string.IsNullOrWhiteSpace(r.RECEIVERMOBILE))
                                                {
                                                    <a class="text-decoration-none" href="tel:@r.RECEIVERMOBILE"><i class="fas fa-phone me-1"></i>@r.RECEIVERMOBILE</a>
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </div>
                                        </td>
                                        <td data-label="Location"><div class="sd-cell">@place</div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="sd-empty" data-empty="all" style="@(sec.Rows.Count == 0 ? "" : "display:none")">
                        <i class="far fa-folder-open"></i> No dispatch in "@sec.Title".
                    </div>
                    <div class="sd-empty" data-empty="filter" style="display:none">
                        <i class="fas fa-filter-circle-xmark"></i> No dispatch matched your filter.
                    </div>
                </div>
            }

            <div class="small text-muted mt-2">"Waiting to Send" shows dispatches of the last 7 days (same as the old desk).</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();

            var U = { receive: '@Url.Action("DeskReceive", "Dispatch")', scan: '@Url.Action("DeskScan", "Dispatch")' };

            /* ----- Receive one row (old btnReceiveEdit, remarks "Received") ----- */
            document.querySelectorAll('.sd-btn[data-act="receive"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var tr = b.closest('tr');
                    SD.confirm({
                        title: 'Receive this dispatch?', text: tr.dataset.title, tone: 'success', icon: 'fa-check', yesText: 'Receive',
                        reason: { label: 'Remarks (optional)', max: 100 },
                        run: function (remarks) { return SD.post(U.receive, { id: tr.dataset.id, remarks: remarks || '' }); }
                    }).then(function (res) {
                        if (res && res.success) { SD.toast(res.message); setTimeout(function () { location.reload(); }, 900); }
                    });
                });
            });

            /* ----- scan box (old btnSearch + auto submit when the scanned id is complete) ----- */
            var form = document.getElementById('scanForm'), box = document.getElementById('scanTx'), busy = false;
            function scan() {
                var tx = box.value.trim();
                if (!tx || busy) { if (!tx) SD.toast('Enter Transaction ID', true); return; }
                busy = true;
                SD.post(U.scan, { tx: tx })
                    .then(function (res) { SD.toast(res.message, !res.success); })
                    .catch(function () { SD.toast('Server error. Please try again.', true); })
                    .then(function () { busy = false; box.value = ''; box.focus(); });
            }
            // a barcode scanner sends Enter after the id -> submit. (The old "search at 15 characters" is not used:
            // ids can be longer, so it could search with half an id.)
            form.addEventListener('submit', function (e) { e.preventDefault(); scan(); });
        })();
    </script>
}
