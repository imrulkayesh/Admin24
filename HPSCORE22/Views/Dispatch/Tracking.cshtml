@* Views/Dispatch/Tracking.cshtml  (old YA: Pages/Dispatch/Tracking.aspx)
   Search a dispatch id -> the chain of steps: first box = sender (old lblFirst), then every DP_TRANSITS row (old rptSteps),
   the open step is highlighted. Each step shows by / received / released / remarks (old tooltip, now always visible).
   Below: my dispatches on the way (old rptGatePass) with View and Track. *@
@model AlphaCare.Models.TrackingViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dispatch Tracking";
    var f = Model.Found;
}

<style>
    .tk-chain { display: flex; flex-wrap: wrap; gap: 10px 0; align-items: stretch; margin: 6px 0 4px; }
    .tk-step { position: relative; display: flex; align-items: stretch; }
    .tk-box { border: 1px solid #cbd5e1; border-radius: 10px; background: #f8fafc; padding: 8px 12px; min-width: 170px; max-width: 260px; font-size: 13px; }
    .tk-box .tk-name { font-weight: 700; color: #1e293b; word-break: break-word; }
    .tk-box .tk-meta { color: #64748b; font-size: 12px; margin-top: 3px; line-height: 1.35; }
    .tk-box.first { background: #eef2ff; border-color: #a5b4fc; }
    .tk-box.done { background: #f0fdf4; border-color: #86efac; }
    .tk-box.active { background: #fef9c3; border-color: #facc15; box-shadow: 0 0 0 3px rgba(250, 204, 21, .25); }
    .tk-arrow { display: flex; align-items: center; color: #94a3b8; padding: 0 8px; }
    @@media (max-width: 575px) {
        .tk-chain { flex-direction: column; }
        .tk-box { max-width: none; width: 100%; }
        .tk-arrow { padding: 4px 0; justify-content: center; transform: rotate(90deg); }
    }
</style>

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">

        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-route me-2"></i>Dispatch Tracking</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            <!-- old tbxSearchDispatch + btnSearch (GET, so a tracking can be bookmarked / shared) -->
            <form method="get" action="@Url.Action("Tracking", "Dispatch")" class="mb-3" autocomplete="off">
                <div class="input-group" style="max-width:560px">
                    <input type="text" name="tx" id="tkTx" class="form-control" maxlength="50" value="@Model.Search" placeholder="Enter Dispatch Transaction ID" autofocus />
                    <button type="submit" class="btn btn-primary"><i class="fas fa-magnifying-glass me-1"></i>Search</button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-warning py-2"><i class="fas fa-circle-exclamation me-1"></i>@Model.Message</div>
            }

            @if (f != null)
            {
                <div class="border rounded-3 p-3 mb-4">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                        <div>
                            <span class="fw-bold fs-6">@f.TRANSACTIONID</span>
                            <span class="text-muted ms-2">@f.ISSUETYPENAME</span>
                            @if (f.COMPLETED == 1)
                            {
                                <span class="badge bg-success ms-2">Completed</span>
                            }
                            else if (f.STATUSID >= 98)
                            {
                                <span class="badge bg-danger ms-2">Rejected</span>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <span class="small text-muted align-self-center">@(f.CREATEDATE?.ToString("dd/MM/yyyy hh:mm tt"))</span>
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("ViewDispatch", "Dispatch", new { id = f.ID })"><i class="fas fa-eye me-1"></i>Details</a>
                        </div>
                    </div>

                    <div class="tk-chain">
                        <div class="tk-step">
                            <div class="tk-box first">
                                <div class="tk-name"><i class="fas fa-user-tag me-1"></i>@f.FirstStep</div>
                                <div class="tk-meta">Sender</div>
                            </div>
                        </div>
                        @foreach (var t in Model.Steps)
                        {
                            bool active = t.ISACTIVE == 1;
                            string by = string.IsNullOrWhiteSpace(t.EMPLOYEENAME) ? (t.UPDATEDBY ?? "") : t.EMPLOYEENAME + " (" + t.UPDATEDBY + ")";
                            <div class="tk-step">
                                <div class="tk-arrow"><i class="fas fa-chevron-right"></i></div>
                                <div class="tk-box @(active ? "active" : "done")">
                                    <div class="tk-name">
                                        @if (active)
                                        {
                                            <i class="fas fa-location-dot me-1"></i>
                                        }
                                        @t.STEP
                                    </div>
                                    <div class="tk-meta">
                                        @if (!string.IsNullOrWhiteSpace(by))
                                        {
                                            <div>By: @by</div>
                                        }
                                        <div>Received: @(t.RECEIVEDATE?.ToString("dd/MM/yyyy hh:mm tt") ?? "-")</div>
                                        <div>Released: @(t.RELEASEDATE?.ToString("dd/MM/yyyy hh:mm tt") ?? (active ? "waiting" : "-"))</div>
                                        @if (!string.IsNullOrWhiteSpace(t.REMARKS))
                                        {
                                            <div>Remarks: @t.REMARKS</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (Model.Steps.Count == 0)
                    {
                        <div class="text-muted small">No step yet.</div>
                    }
                </div>
            }

            <!-- old rptGatePass: my dispatches on the way -->
            <h6 class="fw-bold mb-2"><i class="fas fa-truck-fast me-2 text-primary"></i>My dispatches on the way <span class="badge bg-secondary">@Model.Mine.Count</span> (Showing data from the last 30 days. To view older records, please use the search option above.) </h6>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search dispatch id, sender, receiver, step..." autocomplete="off" />
                </div>
                <div class="input-group" style="max-width:210px">
                    <span class="input-group-text bg-white"><i class="far fa-calendar text-muted"></i></span>
                    <input type="date" class="form-control" id="sdDate" title="Show one date only" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">Action</th>
                                <th class="sortable" data-sort="tx">Dispatch ID<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="date">Date<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="sender">Sender<i class="fas fa-sort arr"></i></th>
                                <th>Sender Mobile</th>
                                <th class="sortable" data-sort="rec">Receiver<i class="fas fa-sort arr"></i></th>
                                <th>Receiver Mobile</th>
                                <th>Current Step</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int idx = 0;
                            }
                            @foreach (var r in Model.Mine)
                            {
                                string sender = $"{r.CENTERCODE}-{r.EMPLOYEENAME}";
                                string receiver = $"{r.BUSINESSCENTER}-{r.RECEIVERNAME}";
                                string search = $"{r.TRANSACTIONID} {r.ISSUETYPENAME} {sender} {receiver} {r.OFFICEMOBILE} {r.RECEIVERMOBILE} {r.CURRENTSTEP}".ToLower();
                                <tr data-search="@search" data-i="@(idx++)" data-date="@(r.CREATEDATE?.ToString("yyyy-MM-dd"))"
                                    data-k-tx="@((r.TRANSACTIONID ?? "").ToLower())" data-k-date="@(r.CREATEDATE?.Ticks ?? 0)"
                                    data-k-sender="@sender.ToLower()" data-k-rec="@receiver.ToLower()">
                                    <td class="text-center text-nowrap" data-label="Action">
                                        <div class="sd-cell">
                                            <a class="sd-btn" title="Track" href="@Url.Action("Tracking", "Dispatch", new { tx = r.TRANSACTIONID })"><i class="fas fa-route"></i></a>
                                            <a class="sd-btn" title="View Details" href="@Url.Action("ViewDispatch", "Dispatch", new { id = r.ID })"><i class="fas fa-eye"></i></a>
                                        </div>
                                    </td>
                                    <td data-label="Dispatch ID" class="text-nowrap"><div class="sd-cell"><a class="sd-title" href="@Url.Action("Tracking", "Dispatch", new { tx = r.TRANSACTIONID })">@r.TRANSACTIONID</a></div></td>
                                    <td data-label="Date" class="text-nowrap"><div class="sd-cell">@(r.CREATEDATE?.ToString("dd/MM/yyyy hh:mm tt") ?? "-")</div></td>
                                    <td data-label="Sender"><div class="sd-cell">@sender</div></td>
                                    <td data-label="Sender Mobile" class="text-nowrap"><div class="sd-cell">@(string.IsNullOrWhiteSpace(r.OFFICEMOBILE) ? "-" : r.OFFICEMOBILE)</div></td>
                                    <td data-label="Receiver"><div class="sd-cell">@receiver</div></td>
                                    <td data-label="Receiver Mobile" class="text-nowrap"><div class="sd-cell">@(string.IsNullOrWhiteSpace(r.RECEIVERMOBILE) ? "-" : r.RECEIVERMOBILE)</div></td>
                                    <td data-label="Current Step"><div class="sd-cell">@(string.IsNullOrWhiteSpace(r.CURRENTSTEP) ? "-" : r.CURRENTSTEP)</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Mine.Count == 0 ? "" : "display:none")">
                    <i class="far fa-folder-open"></i> No dispatch of yours is on the way.
                </div>
                <div class="sd-empty" data-empty="filter" style="display:none">
                    <i class="fas fa-filter-circle-xmark"></i> No dispatch matched your filter.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SD.initList();
        // put the cursor at the end of the pre-filled id (old page: the user types the last digits)
        (function () { var b = document.getElementById('tkTx'); if (b) { var n = b.value.length; b.focus(); b.setSelectionRange(n, n); } })();
    </script>
}
