@* Views/Dispatch/GateMan.cshtml  (old YA: Pages/Dispatch/AssignGateMan.aspx)
   Setup of DP_ASSIGNGATEMAN for one location: which employee works at which gate number (shown on Gate Check as "Gate#").
   Add / edit of active rows. No remove (the old delete button was switched off). *@
@model AlphaCare.Models.GateManSetupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Assign Gate Man";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-user-lock me-2"></i>Assign Gate Man</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                <div class="col-md-4">
                    <label for="fStaff" class="form-label fw-semibold">Gate Man (Staff ID) <span class="text-danger">*</span></label>
                    <input type="text" id="fStaff" class="form-control" list="dlEmp" placeholder="Type ID or name" />
                    <div class="small text-muted mt-1" id="fEmpInfo"></div>
                </div>
                <div class="col-md-4">
                    <label for="fCenter" class="form-label fw-semibold">Location <span class="text-danger">*</span></label>
                    <select id="fCenter" class="form-select">
                        <option value="0">-- Select --</option>
                        @foreach (var c in Model.BusinessCenters)
                        {
                            <option value="@c.ID" selected="@(c.ID == Model.CenterId)">@c.CENTERNAME</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label for="fGate" class="form-label fw-semibold">Gate No <span class="text-danger">*</span></label>
                    <input type="number" id="fGate" class="form-control" min="1" max="999" step="1" value="1" />
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset" title="Refresh"><i class="fas fa-rotate"></i></button>
                </div>
            </form>
            <datalist id="dlEmp"></datalist>

            <form method="get" action="@Url.Action("GateMan", "Dispatch")" class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <label for="listCenter" class="fw-semibold">Gate men of</label>
                <select id="listCenter" name="centerId" class="form-select" style="max-width:320px" onchange="this.form.submit()">
                    @foreach (var c in Model.BusinessCenters)
                    {
                        <option value="@c.ID" selected="@(c.ID == Model.CenterId)">@c.CENTERNAME</option>
                    }
                </select>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search staff, name, gate..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">Action</th>
                                <th class="sortable" data-sort="name">Name<i class="fas fa-sort arr"></i></th>
                                <th>Staff ID</th>
                                <th>Location</th>
                                <th>Designation</th>
                                <th>Mobile</th>
                                <th>Email</th>
                                <th class="sortable" data-sort="gate">Gate No<i class="fas fa-sort arr"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var g in Model.Rows)
                            {
                                <tr data-search="@($"{g.STAFFID} {g.EMPLOYEENAME} gate {g.GATENO} {g.DESIGNATIONNAME}".ToLower())" data-i="@(idx++)"
                                    data-k-name="@((g.EMPLOYEENAME ?? "").ToLower())" data-k-gate="@((g.GATENO ?? 0).ToString("D6"))"
                                    data-id="@g.ID" data-staff="@g.STAFFID" data-center="@g.BUSINESSCENTERID" data-gate="@g.GATENO">
                                    <td class="text-center" data-label="Action"><div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div></td>
                                    <td data-label="Name"><div class="sd-cell">@g.EMPLOYEENAME</div></td>
                                    <td data-label="Staff ID"><div class="sd-cell">@g.STAFFID</div></td>
                                    <td data-label="Location"><div class="sd-cell">@g.CENTERNAME</div></td>
                                    <td data-label="Designation"><div class="sd-cell">@g.DESIGNATIONNAME</div></td>
                                    <td data-label="Mobile" class="text-nowrap"><div class="sd-cell">@(string.IsNullOrWhiteSpace(g.OFFICEMOBILE) ? "-" : g.OFFICEMOBILE)</div></td>
                                    <td data-label="Email"><div class="sd-cell">@(string.IsNullOrWhiteSpace(g.OFFICEMAIL) ? "-" : g.OFFICEMAIL)</div></td>
                                    <td data-label="Gate No"><div class="sd-cell">@g.GATENO</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Rows.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No gate man at this location.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No gate man matched your filter.</div>
            </div>
            <div class="small text-muted mt-2">A gate man also needs the menu "Dispatch/GateCheck" to open Gate Check.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var $ = function (id) { return document.getElementById(id); };
            var U = { save: '@Url.Action("SaveGateMan", "Dispatch")', search: '@Url.Action("SearchEmployee", "Dispatch")', emp: '@Url.Action("GetEmployee", "Dispatch")' };
            var listCenter = '@Model.CenterId';

            function reset() { $('fId').value = '0'; $('fStaff').value = ''; $('fEmpInfo').textContent = ''; $('fCenter').value = listCenter; $('fGate').value = '1'; $('fSaveText').textContent = 'Save'; }

            var t = null;
            $('fStaff').addEventListener('input', function () {
                clearTimeout(t);
                var q = this.value.trim();
                if (q.length < 2) return;
                t = setTimeout(function () {
                    fetch(U.search + '?term=' + encodeURIComponent(q), { credentials: 'same-origin' }).then(function (r) { return r.json(); })
                        .then(function (list) { $('dlEmp').innerHTML = list.map(function (s) { return '<option value="' + SD.esc(s) + '"></option>'; }).join(''); })
                        .catch(function () { });
                }, 250);
            });
            function loadEmp() {
                var v = $('fStaff').value.trim();
                if (!v) { $('fEmpInfo').textContent = ''; return; }
                fetch(U.emp + '?staffId=' + encodeURIComponent(v), { credentials: 'same-origin' }).then(function (r) { return r.json(); })
                    .then(function (e) {
                        if (!e.found) { $('fEmpInfo').textContent = 'Employee not found.'; return; }
                        $('fStaff').value = e.staffId;
                        $('fEmpInfo').textContent = [e.name, e.designation, e.mobile, e.email].filter(Boolean).join(' · ');
                    }).catch(function () { });
            }
            $('fStaff').addEventListener('change', loadEmp);

            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var d = b.closest('tr').dataset;
                    $('fId').value = d.id; $('fStaff').value = d.staff || ''; $('fCenter').value = d.center || '0'; $('fGate').value = d.gate || '1';
                    $('fSaveText').textContent = 'Update'; loadEmp(); window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            $('fReset').addEventListener('click', reset);
            $('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                SD.post(U.save, { id: $('fId').value, staffId: $('fStaff').value.trim(), centerId: $('fCenter').value, gateNo: $('fGate').value })
                    .then(function (res) {
                        SD.toast(res.message, !res.success);
                        if (res.success) setTimeout(function () { location.href = '@Url.Action("GateMan", "Dispatch")?centerId=' + encodeURIComponent($('fCenter').value); }, 800);
                    }).catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
