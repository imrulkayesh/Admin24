@* Views/Dispatch/Transport.cshtml  (old YA: Pages/Dispatch/Transport.aspx)
   Setup of DP_TRANSPORT: add / edit a transport (name + Is External). No delete (the old delete button was switched off).
   LIST PAGE - standard look (app-standard.css / app-standard.js: SD.initList, SD.post, SD.toast). *@
@model List<AlphaCare.Models.TransportModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Transport";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">

        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-truck me-2"></i>Transport</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <!-- old form: tbxName + chkIsExternal + Save / Update / Refresh -->
            <form id="trForm" class="row g-2 align-items-end mb-3" autocomplete="off">
                <input type="hidden" id="trId" value="0" />
                <div class="col-md-5">
                    <label for="trName" class="form-label fw-semibold">Transport <span class="text-danger">*</span></label>
                    <input type="text" id="trName" class="form-control" maxlength="100" placeholder="Enter Transport" />
                </div>
                <div class="col-md-3">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="trExt" />
                        <label class="form-check-label fw-semibold" for="trExt">Is External</label>
                    </div>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="trSave"><i class="fas fa-floppy-disk me-1"></i><span>Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="trReset"><i class="fas fa-rotate me-1"></i>Refresh</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search transport..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="name">Transport<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="ext">Is External<i class="fas fa-sort arr"></i></th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int idx = 0;
                            }
                            @foreach (var t in Model)
                            {
                                <tr data-search="@((t.TRANSPORTNAME ?? "").ToLower())" data-id="@t.ID" data-name="@t.TRANSPORTNAME" data-ext="@(t.IsExternal ? 1 : 0)"
                                    data-i="@(idx++)" data-k-name="@((t.TRANSPORTNAME ?? "").ToLower())" data-k-ext="@(t.IsExternal ? 1 : 0)">
                                    <td data-label="Transport"><div class="sd-cell">@t.TRANSPORTNAME</div></td>
                                    <td data-label="Is External"><div class="sd-cell">@(t.IsExternal ? "Yes" : "No")</div></td>
                                    <td class="text-center" data-label="Action">
                                        <div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Count == 0 ? "" : "display:none")">
                    <i class="far fa-folder-open"></i> No transport yet.
                </div>
                <div class="sd-empty" data-empty="filter" style="display:none">
                    <i class="fas fa-filter-circle-xmark"></i> No transport matched your filter.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();

            var id = document.getElementById('trId'), name = document.getElementById('trName'), ext = document.getElementById('trExt');
            var saveText = document.querySelector('#trSave span'), url = '@Url.Action("SaveTransport", "Dispatch")';

            function reset() { id.value = '0'; name.value = ''; ext.checked = false; saveText.textContent = 'Save'; }

            /* old btnEdit_Command: load the row into the form (now with Is External as well) */
            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var tr = b.closest('tr');
                    id.value = tr.dataset.id; name.value = tr.dataset.name || ''; ext.checked = tr.dataset.ext === '1';
                    saveText.textContent = 'Update';
                    name.focus();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });

            document.getElementById('trReset').addEventListener('click', reset);

            document.getElementById('trForm').addEventListener('submit', function (e) {
                e.preventDefault();
                if (!name.value.trim()) { SD.toast('Enter Transport', true); name.focus(); return; }
                SD.post(url, { id: id.value, name: name.value.trim(), isExternal: ext.checked })
                    .then(function (res) {
                        SD.toast(res.message, !res.success);
                        if (res.success) setTimeout(function () { location.reload(); }, 800);
                    })
                    .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
