@* Views/Service/Machine.cshtml  (old YA: Pages/Service/Machine.aspx)
   Setup of SC_MACHINE (outlet / machine) of one location: company, department, name, code. Add / edit, no delete (switched off in YA).
   The machines of the user's location + company are offered on New Service / Instant Service. *@
@model AlphaCare.Models.ServiceSetupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Outlet / Machine";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-gears me-2"></i>Outlet / Machine</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                <div class="col-md-4">
                    <label for="fCenter" class="form-label fw-semibold">Location <span class="text-danger">*</span></label>
                    <select id="fCenter" class="form-select">
                        @foreach (var c in Model.BusinessCenters)
                        {
                            <option value="@c.ID" selected="@(c.ID == Model.CenterId)">@c.CENTERNAME</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="fCompany" class="form-label fw-semibold">Company <span class="text-danger">*</span></label>
                    <select id="fCompany" class="form-select">
                        <option value="0">-- Select --</option>
                        @foreach (var c in Model.Companies)
                        {
                            <option value="@c.ID" selected="@(c.ID == Model.DefaultCompanyId)">@c.COMPANYNAME</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="fDept" class="form-label fw-semibold">Department <span class="text-danger">*</span></label>
                    <select id="fDept" class="form-select">
                        <option value="0">-- Select --</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.ID">@d.DEPARTMENTNAME</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="fName" class="form-label fw-semibold">Machine Name <span class="text-danger">*</span></label>
                    <input type="text" id="fName" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label for="fCode" class="form-label fw-semibold">Machine Code</label>
                    <input type="text" id="fCode" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Refresh</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search machine, code, company, department..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">Action</th>
                                <th class="sortable" data-sort="name">Machine<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="code">Code<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="company">Company<i class="fas fa-sort arr"></i></th>
                                <th>Department</th><th>Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var m in Model.Machines)
                            {
                                <tr data-search="@($"{m.MACHINENAME} {m.MACHINECODE} {m.COMPANYNAME} {m.DEPARTMENTNAME}".ToLower())" data-i="@(idx++)"
                                    data-k-name="@((m.MACHINENAME ?? "").ToLower())" data-k-code="@((m.MACHINECODE ?? "").ToLower())" data-k-company="@((m.COMPANYNAME ?? "").ToLower())"
                                    data-id="@m.ID" data-name="@m.MACHINENAME" data-code="@m.MACHINECODE" data-company="@m.COMPANYID" data-dept="@m.DEPARTMENTID">
                                    <td class="text-center" data-label="Action"><div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div></td>
                                    <td data-label="Machine"><div class="sd-cell">@m.MACHINENAME</div></td>
                                    <td data-label="Code"><div class="sd-cell">@(string.IsNullOrWhiteSpace(m.MACHINECODE) ? "-" : m.MACHINECODE)</div></td>
                                    <td data-label="Company"><div class="sd-cell">@m.COMPANYNAME</div></td>
                                    <td data-label="Department"><div class="sd-cell">@m.DEPARTMENTNAME</div></td>
                                    <td data-label="Location"><div class="sd-cell">@m.CENTERNAME</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Machines.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No machine at this location.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No machine matched your filter.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var $ = function (id) { return document.getElementById(id); };
            var J = window.jQuery;
            var base = '@Url.Action("Machine", "Service")';
            function setSel(el, v) { el.value = v; J(el).trigger('change.select2'); }
            function editing() { return $('fId').value !== '0'; }
            J($('fCenter')).on('change', function () { if (!editing()) location.href = base + '?centerId=' + encodeURIComponent(this.value); });

            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var d = b.closest('tr').dataset;
                    $('fId').value = d.id; $('fName').value = d.name || ''; $('fCode').value = d.code || '';
                    setSel($('fCompany'), d.company || '0'); setSel($('fDept'), d.dept || '0');
                    $('fSaveText').textContent = 'Update'; window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            $('fReset').addEventListener('click', function () { location.href = base + '?centerId=@Model.CenterId'; });
            $('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                SD.post('@Url.Action("SaveMachine", "Service")', {
                    id: $('fId').value, centerId: $('fCenter').value, companyId: $('fCompany').value, departmentId: $('fDept').value,
                    name: $('fName').value.trim(), code: $('fCode').value.trim()
                }).then(function (res) {
                    SD.toast(res.message, !res.success);
                    if (res.success) setTimeout(function () { location.href = base + '?centerId=' + encodeURIComponent($('fCenter').value); }, 800);
                }).catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
