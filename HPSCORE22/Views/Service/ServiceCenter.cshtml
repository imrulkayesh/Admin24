@* Views/Service/ServiceCenter.cshtml  (old YA: Pages/Service/ServiceCenter.aspx)
   Setup of SC_SERVICECENTER: name, location (business center), center admin (employee). Add / edit, no delete (switched off in YA).
   The list shows every service center (old dalServiceCenter.GetAll). *@
@model AlphaCare.Models.ServiceSetupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Service Center";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-building me-2"></i>Service Center</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                <div class="col-md-4">
                    <label for="fCenter" class="form-label fw-semibold">Location <span class="text-danger">*</span></label>
                    <select id="fCenter" class="form-select">
                        <option value="0">-- Select --</option>
                        @foreach (var c in Model.BusinessCenters)
                        {
                            <option value="@c.ID" selected="@(c.ID == Model.CenterId)">@c.CENTERNAME</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="fName" class="form-label fw-semibold">Service Center Name <span class="text-danger">*</span></label>
                    <input type="text" id="fName" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label for="fStaff" class="form-label fw-semibold">Admin Staff ID <span class="text-danger">*</span></label>
                    <input type="text" id="fStaff" class="form-control" list="dlEmp" placeholder="Type ID or name" />
                    <div class="small text-muted mt-1" id="fEmpInfo"></div>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Refresh</button>
                </div>
            </form>
            <datalist id="dlEmp"></datalist>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search service center, location, admin..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">Action</th>
                                <th class="sortable" data-sort="name">Service Center<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="loc">Location<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="admin">Admin<i class="fas fa-sort arr"></i></th>
                                <th>Designation</th>
                                <th>Department</th>
                                <th>Mobile</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var c in Model.Centers)
                            {
                                <tr data-search="@($"{c.SERVICECENTERNAME} {c.CENTERNAME} {c.CENTERADMIN} {c.EMPLOYEENAME} {c.DEPARTMENTCODE}".ToLower())" data-i="@(idx++)"
                                    data-k-name="@((c.SERVICECENTERNAME ?? "").ToLower())" data-k-loc="@((c.CENTERNAME ?? "").ToLower())" data-k-admin="@((c.EMPLOYEENAME ?? "").ToLower())"
                                    data-id="@c.ID" data-name="@c.SERVICECENTERNAME" data-center="@c.BUSINESSCENTERID" data-staff="@c.CENTERADMIN">
                                    <td class="text-center" data-label="Action"><div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div></td>
                                    <td data-label="Service Center"><div class="sd-cell">@c.SERVICECENTERNAME</div></td>
                                    <td data-label="Location"><div class="sd-cell">@c.CENTERNAME</div></td>
                                    <td data-label="Admin"><div class="sd-cell">@c.EMPLOYEENAME<span class="sd-sub">@c.CENTERADMIN</span></div></td>
                                    <td data-label="Designation"><div class="sd-cell">@c.DESIGNATIONNAME</div></td>
                                    <td data-label="Department"><div class="sd-cell">@c.DEPARTMENTCODE</div></td>
                                    <td data-label="Mobile" class="text-nowrap"><div class="sd-cell">@(string.IsNullOrWhiteSpace(c.OFFICEMOBILE) ? "-" : c.OFFICEMOBILE)</div></td>
                                    <td data-label="Email"><div class="sd-cell">@(string.IsNullOrWhiteSpace(c.OFFICEMAIL) ? "-" : c.OFFICEMAIL)</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Centers.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No service center yet.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No service center matched your filter.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var $ = function (id) { return document.getElementById(id); };
            var U = { save: '@Url.Action("SaveServiceCenter", "Service")', search: '@Url.Action("SearchEmployee", "Service")', emp: '@Url.Action("GetEmployee", "Service")' };
            var defCenter = '@Model.CenterId';
            function setSel(el, v) { el.value = v; window.jQuery && jQuery(el).trigger('change.select2'); }
            function reset() { $('fId').value = '0'; $('fName').value = ''; $('fStaff').value = ''; $('fEmpInfo').textContent = ''; setSel($('fCenter'), defCenter); $('fSaveText').textContent = 'Save'; }

            /* admin staff auto complete (old AutoCompleteExtender + tbxStaffID_TextChanged) */
            var t = null;
            $('fStaff').addEventListener('input', function () {
                clearTimeout(t); var q = this.value.trim(); if (q.length < 2) return;
                t = setTimeout(function () {
                    fetch(U.search + '?term=' + encodeURIComponent(q), { credentials: 'same-origin' }).then(function (r) { return r.json(); })
                        .then(function (l) { $('dlEmp').innerHTML = l.map(function (s) { return '<option value="' + SD.esc(s) + '"></option>'; }).join(''); }).catch(function () { });
                }, 250);
            });
            function loadEmp() {
                var v = $('fStaff').value.trim(); if (!v) { $('fEmpInfo').textContent = ''; return; }
                fetch(U.emp + '?staffId=' + encodeURIComponent(v), { credentials: 'same-origin' }).then(function (r) { return r.json(); })
                    .then(function (e) {
                        if (!e.found) { $('fEmpInfo').textContent = 'Employee not found.'; return; }
                        $('fStaff').value = e.staffId; $('fEmpInfo').textContent = [e.name, e.designation, e.mobile, e.email].filter(Boolean).join(' · ');
                    }).catch(function () { });
            }
            $('fStaff').addEventListener('change', loadEmp);

            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var d = b.closest('tr').dataset;
                    $('fId').value = d.id; $('fName').value = d.name || ''; $('fStaff').value = d.staff || ''; setSel($('fCenter'), d.center || '0');
                    $('fSaveText').textContent = 'Update'; loadEmp(); window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            $('fReset').addEventListener('click', reset);
            $('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                SD.post(U.save, { id: $('fId').value, name: $('fName').value.trim(), centerId: $('fCenter').value, adminStaffId: $('fStaff').value.trim() })
                  .then(function (res) { SD.toast(res.message, !res.success); if (res.success) setTimeout(function () { location.reload(); }, 800); })
                  .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
