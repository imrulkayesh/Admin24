@* Views/Service/Accessories.cshtml  (old YA: Pages/Service/Accessories.aspx)
   Setup of SC_ACCESSORIES of one service center: category, name, stock. Add / edit, no delete (switched off in YA). *@
@model AlphaCare.Models.ServiceSetupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Accessories";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-toolbox me-2"></i>Accessories</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                <div class="col-md-3">
                    <label for="fCenter" class="form-label fw-semibold">Location <span class="text-danger">*</span></label>
                    <select id="fCenter" class="form-select">
                        @foreach (var c in Model.BusinessCenters)
                        {
                            <option value="@c.ID" selected="@(c.ID == Model.CenterId)">@c.CENTERNAME</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fSc" class="form-label fw-semibold">Service Center <span class="text-danger">*</span></label>
                    <select id="fSc" class="form-select">
                        <option value="0">-- Select --</option>
                        @foreach (var s in Model.ServiceCenters)
                        {
                            <option value="@s.ID" selected="@(s.ID == Model.ServiceCenterId)">@s.NAME</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fCategory" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                    <select id="fCategory" class="form-select">
                        <option value="0">-- Select --</option>
                        @foreach (var c in Model.AccessoryCategories)
                        {
                            <option value="@c.ID">@c.ACCESSORIESCATEGORY</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fName" class="form-label fw-semibold">Accessories Name <span class="text-danger">*</span></label>
                    <input type="text" id="fName" class="form-control" maxlength="200" />
                </div>
                <div class="col-6 col-md-2">
                    <label for="fStock" class="form-label fw-semibold">Stock <span class="text-danger">*</span></label>
                    <input type="text" id="fStock" class="form-control" inputmode="numeric" />
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Refresh</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search accessories, category..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">Action</th>
                                <th class="sortable" data-sort="name">Accessories<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="cat">Category<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="stock">Stock<i class="fas fa-sort arr"></i></th>
                                <th>Service Center</th><th>Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var x in Model.Accessories)
                            {
                                <tr data-search="@($"{x.ACCESSORIESNAME} {x.ACCESSORIESCATEGORY}".ToLower())" data-i="@(idx++)"
                                    data-k-name="@((x.ACCESSORIESNAME ?? "").ToLower())" data-k-cat="@((x.ACCESSORIESCATEGORY ?? "").ToLower())" data-k-stock="@((x.STOCK ?? 0).ToString("D9"))"
                                    data-id="@x.ID" data-name="@x.ACCESSORIESNAME" data-cat="@x.CATEGORYID" data-stock="@x.STOCK">
                                    <td class="text-center" data-label="Action"><div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div></td>
                                    <td data-label="Accessories"><div class="sd-cell">@x.ACCESSORIESNAME</div></td>
                                    <td data-label="Category"><div class="sd-cell">@x.ACCESSORIESCATEGORY</div></td>
                                    <td data-label="Stock"><div class="sd-cell">@x.STOCK</div></td>
                                    <td data-label="Service Center"><div class="sd-cell">@x.SERVICECENTERNAME</div></td>
                                    <td data-label="Location"><div class="sd-cell">@x.CENTERCODE</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Accessories.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No accessory for this service center.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No accessory matched your filter.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var $ = function (id) { return document.getElementById(id); };
            var J = window.jQuery;
            var base = '@Url.Action("Accessories", "Service")', scUrl = '@Url.Action("ServiceCenters", "Service")';
            function editing() { return $('fId').value !== '0'; }
            function go(q) { location.href = base + '?' + new URLSearchParams(q).toString(); }
            function setSel(el, v) { el.value = v; J(el).trigger('change.select2'); }
            function fillSc(list) { var s = $('fSc'); s.innerHTML = '<option value="0">-- Select --</option>'; list.forEach(function (o) { s.add(new Option(o.name, o.id)); }); J(s).trigger('change.select2'); }
            J($('fCenter')).on('change', function () {
                if (!editing()) { go({ centerId: this.value }); return; }
                fetch(scUrl + '?centerId=' + encodeURIComponent(this.value), { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(fillSc).catch(function () { });
            });
            J($('fSc')).on('change', function () { if (!editing()) go({ centerId: $('fCenter').value, serviceCenterId: this.value }); });

            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var d = b.closest('tr').dataset;
                    $('fId').value = d.id; $('fName').value = d.name || ''; $('fStock').value = d.stock || '0'; setSel($('fCategory'), d.cat || '0');
                    $('fSaveText').textContent = 'Update'; window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            $('fReset').addEventListener('click', function () { go({ centerId: '@Model.CenterId', serviceCenterId: '@Model.ServiceCenterId' }); });
            $('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                SD.post('@Url.Action("SaveAccessory", "Service")', {
                    id: $('fId').value, categoryId: $('fCategory').value, name: $('fName').value.trim(), stock: $('fStock').value.trim(),
                    centerId: $('fCenter').value, serviceCenterId: $('fSc').value
                }).then(function (res) {
                    SD.toast(res.message, !res.success);
                    if (res.success) setTimeout(function () { go({ centerId: $('fCenter').value, serviceCenterId: $('fSc').value }); }, 800);
                }).catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
