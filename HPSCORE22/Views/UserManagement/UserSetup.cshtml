@* Views/UserManagement/UserSetup.cshtml (old YA: UserSetup.aspx and UserStatusUpdate.aspx - same page,
   the status variant adds the Activate / Deactivate buttons).
   Create: UC_USERS (user = staff id, legacy password = staff id) + EM_EMPLOYEE + UC_USERROLE.
   Edit: loads the user into the form (staff id locked), updates user + employee + role. *@
@model AlphaCare.Models.UserSetupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string action = Model.WithStatusButtons ? "UserStatusUpdate" : "UserSetup";
    ViewData["Title"] = Model.WithStatusButtons ? "User Status Update" : "User Setup";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas @(Model.WithStatusButtons ? "fa-user-check" : "fa-user-plus") me-2"></i>@ViewData["Title"]</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @if (TempData["msg"] is string tmsg && !string.IsNullOrEmpty(tmsg))
            {
                <div class="alert alert-warning py-2"><i class="fas fa-circle-exclamation me-1"></i>@tmsg</div>
            }
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 mb-3" autocomplete="off">
                <input type="hidden" id="fEdit" value="0" />
                <div class="col-md-3">
                    <label for="fStaff" class="form-label fw-semibold">Staff ID <span class="text-danger">*</span></label>
                    <input type="text" id="fStaff" class="form-control" list="dlStaff" maxlength="50" placeholder="Type ID or name" />
                    <datalist id="dlStaff"></datalist>
                </div>
                <div class="col-md-3">
                    <label for="fName" class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                    <input type="text" id="fName" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-3">
                    <label for="fMobile" class="form-label fw-semibold">Mobile</label>
                    <input type="text" id="fMobile" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-3">
                    <label for="fEmail" class="form-label fw-semibold">Email</label>
                    <input type="text" id="fEmail" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-3">
                    <label for="fRole" class="form-label fw-semibold">Role <span class="text-danger">*</span></label>
                    <select id="fRole" class="form-select">
                        @foreach (var o in Model.Roles) { <option value="@o.Value">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fCenter" class="form-label fw-semibold">Business Center <span class="text-danger">*</span></label>
                    <select id="fCenter" class="form-select">
                        @foreach (var o in Model.Centers) { <option value="@o.Value">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fCompany" class="form-label fw-semibold">Company <span class="text-danger">*</span></label>
                    <select id="fCompany" class="form-select">
                        @foreach (var o in Model.Companies) { <option value="@o.Value">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fDept" class="form-label fw-semibold">Department <span class="text-danger">*</span></label>
                    <select id="fDept" class="form-select">
                        @foreach (var o in Model.Departments) { <option value="@o.Value">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fDesig" class="form-label fw-semibold">Designation <span class="text-danger">*</span></label>
                    <select id="fDesig" class="form-select">
                        @foreach (var o in Model.Designations) { <option value="@o.Value">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-3" id="pwdWrap" style="display:none">
                    <label for="fPwd" class="form-label fw-semibold">New Password</label>
                    <input type="password" id="fPwd" class="form-control" maxlength="50" autocomplete="new-password" placeholder="Leave empty to keep" />
                </div>
                <div class="col-md-3" id="pwdWrap2" style="display:none">
                    <label for="fPwd2" class="form-label fw-semibold">Confirm Password</label>
                    <input type="password" id="fPwd2" class="form-control" maxlength="50" autocomplete="new-password" />
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Reset</button>
                </div>
            </form>

            <hr />

            <form method="get" action="@Url.Action(action, "UserManagement")" class="row g-2 align-items-end mb-3" autocomplete="off">
                <div class="col-md-4">
                    <label for="gCenter" class="form-label fw-semibold">Business Center (list)</label>
                    <select id="gCenter" name="centerId" class="form-select" onchange="this.form.submit()">
                        @foreach (var o in Model.Centers) { <option value="@o.Value" selected="@(o.Value == Model.CenterId.ToString())">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="gSearch" class="form-label fw-semibold">Search by Staff ID</label>
                    <input type="text" id="gSearch" name="search" class="form-control" maxlength="50" value="@Model.Search" placeholder="Exact Staff ID" />
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-outline-primary"><i class="fas fa-magnifying-glass me-1"></i>Search</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search in the list..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all" data-page-size="25">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th class="sortable" data-sort="name">Name<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="user">Username<i class="fas fa-sort arr"></i></th>
                                <th>Mobile</th><th>Center</th><th>Department</th><th>Designation</th><th>Role</th><th>Active</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var u = Model.Rows[i];
                                <tr data-search="@(((u.EMPLOYEENAME ?? "") + " " + (u.USERNAME ?? "") + " " + (u.OFFICEMOBILE ?? "") + " " + (u.ROLENAME ?? "")).ToLower())"
                                    data-i="@i" data-id="@u.ID" data-k-name="@((u.EMPLOYEENAME ?? "").ToLower())" data-k-user="@((u.USERNAME ?? "").ToLower())">
                                    <td class="text-center text-muted" data-label="#"><div class="sd-cell">@(i + 1)</div></td>
                                    <td data-label="Name"><div class="sd-cell">@u.EMPLOYEENAME</div></td>
                                    <td data-label="Username"><div class="sd-cell">@u.USERNAME</div></td>
                                    <td data-label="Mobile"><div class="sd-cell">@(u.OFFICEMOBILE ?? "-")</div></td>
                                    <td data-label="Center"><div class="sd-cell">@u.CENTERCODE</div></td>
                                    <td data-label="Department"><div class="sd-cell">@u.DEPARTMENTCODE</div></td>
                                    <td data-label="Designation"><div class="sd-cell">@u.DESIGNATIONNAME</div></td>
                                    <td data-label="Role"><div class="sd-cell">@u.ROLENAME</div></td>
                                    <td data-label="Active"><div class="sd-cell"><span class="badge @(u.ISACTIVE == 1 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">@(u.ISACTIVE == 1 ? "Active" : "Inactive")</span></div></td>
                                    <td class="text-center" data-label="Action">
                                        <div class="sd-cell d-inline-flex gap-1">
                                            <button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button>
                                            @if (Model.WithStatusButtons)
                                            {
                                                if (u.ISACTIVE == 1)
                                                {
                                                    <button type="button" class="sd-btn" title="Deactivate" data-act="off"><i class="fas fa-user-slash"></i></button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="sd-btn ok" title="Activate" data-act="on"><i class="fas fa-user-check"></i></button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Rows.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No user found.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No row matched your search.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var byId = function (id) { return document.getElementById(id); };

            // staff id auto complete (old AutoCompleteExtender)
            var t = null;
            byId('fStaff').addEventListener('input', function () {
                clearTimeout(t);
                var q = byId('fStaff').value.trim();
                if (q.length < 2) return;
                t = setTimeout(function () {
                    fetch('@Url.Action("SearchStaff", "UserManagement")?term=' + encodeURIComponent(q), { credentials: 'same-origin' })
                        .then(function (r) { return r.json(); })
                        .then(function (list) { byId('dlStaff').innerHTML = list.map(function (s) { return '<option value="' + SD.esc(s) + '"></option>'; }).join(''); })
                        .catch(function () { });
                }, 250);
            });

            // the drop downs are Select2 (app-standard.js): after setting .value the visible box must be refreshed,
            // otherwise Edit shows the previous choices while other values are posted
            function setSel(el, v) {
                el.value = (v === null || v === undefined) ? '' : String(v);
                if (el.value === '' && el.options.length > 0 && (v === null || v === undefined || v === '')) el.selectedIndex = 0;
                if (window.jQuery) window.jQuery(el).trigger('change.select2');
            }
            var selIds = ['fRole', 'fCenter', 'fCompany', 'fDept', 'fDesig'];

            function reset() {
                selIds.forEach(function (id) { setSel(byId(id), ''); });
                byId('fEdit').value = '0';
                ['fStaff', 'fName', 'fMobile', 'fEmail', 'fPwd', 'fPwd2'].forEach(function (id) { byId(id).value = ''; });
                byId('fStaff').readOnly = false;
                byId('fSaveText').textContent = 'Save';
                byId('pwdWrap').style.display = byId('pwdWrap2').style.display = 'none';
            }
            byId('fReset').addEventListener('click', reset);

            function fill(staffId) {
                fetch('@Url.Action("GetUser", "UserManagement")?staffId=' + encodeURIComponent(staffId), { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        if (!res.found) { SD.toast('User not found.', true); return; }
                        var u = res.user;
                        byId('fEdit').value = '1';
                        byId('fStaff').value = u.STAFFID || ''; byId('fStaff').readOnly = true;
                        byId('fName').value = u.EMPLOYEENAME || '';
                        byId('fMobile').value = u.OFFICEMOBILE || '';
                        byId('fEmail').value = u.OFFICEMAIL || '';
                        setSel(byId('fRole'), u.ROLEID); setSel(byId('fCenter'), u.BUSINESSCENTERID);
                        setSel(byId('fCompany'), u.COMPANYID); setSel(byId('fDept'), u.DEPTID); setSel(byId('fDesig'), u.DESIGNATIONID);
                        if (!byId('fRole').value) SD.toast('This user\'s role is not in your Role list - choose a role before Update.', true);
                        byId('fSaveText').textContent = 'Update';
                        byId('pwdWrap').style.display = byId('pwdWrap2').style.display = '';
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    })
                    .catch(function () { SD.toast('Could not load the user.', true); });
            }
            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () { fill(b.closest('tr').dataset.id); });
            });

            // activate / deactivate (UserStatusUpdate page only)
            document.querySelectorAll('.sd-btn[data-act="on"], .sd-btn[data-act="off"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var active = b.dataset.act === 'on';
                    SD.confirm({
                        title: (active ? 'Activate' : 'Deactivate') + ' this user?', tone: active ? 'success' : 'danger',
                        icon: active ? 'fa-user-check' : 'fa-user-slash', yesText: active ? 'Activate' : 'Deactivate',
                        run: function () { return SD.post('@Url.Action("SetUserStatus", "UserManagement")', { staffId: b.closest('tr').dataset.id, active: active }); }
                    }).then(function (res) { if (res && res.success) { SD.toast(res.message); setTimeout(function () { location.reload(); }, 700); } });
                });
            });

            byId('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                var isEdit = byId('fEdit').value === '1';
                var pwd = byId('fPwd').value;
                if (!byId('fStaff').value.trim()) { SD.toast('Enter the Staff ID.', true); return; }
                if (!byId('fName').value.trim()) { SD.toast('Enter the Name.', true); return; }
                if (isEdit && pwd && pwd !== byId('fPwd2').value) { SD.toast('Password and confirm password does not match', true); return; }
                var btn = e.submitter || byId('fm').querySelector('button[type="submit"]');
                var btnHtml = btn.innerHTML;
                var unlock = function () { btn.disabled = false; btn.innerHTML = btnHtml; };
                SD.lock(btn, isEdit ? 'Updating...' : 'Saving...');
                SD.post('@Url.Action("SaveUser", "UserManagement")', {
                    StaffId: byId('fStaff').value, Name: byId('fName').value, Mobile: byId('fMobile').value, Email: byId('fEmail').value,
                    Password: isEdit ? pwd : '', RoleId: byId('fRole').value, CenterId: byId('fCenter').value,
                    CompanyId: byId('fCompany').value, DepartmentId: byId('fDept').value, DesignationId: byId('fDesig').value, IsEdit: isEdit
                }).then(function (res) {
                    SD.toast(res.message, !res.success);
                    if (res.success) setTimeout(function () { location.reload(); }, 800);
                    else unlock();
                }).catch(function () { unlock(); SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
