@* Views/UserManagement/ChangePassword.cshtml (old YA: ChangePassword.aspx)
   Resets the legacy UC_USERS password (the YA system logs in with it; Admin24 itself verifies via HRIS). *@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Change Password";
    string userId = ViewBag.UserId as string ?? "";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0" style="max-width:560px">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-key me-2"></i>Change Password</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            <p class="text-muted small mb-3"><i class="fas fa-circle-info me-1"></i>This resets the legacy (YA) password of the account. Admin24 logins are verified by HRIS and are not affected.</p>
            @Html.AntiForgeryToken()

            <form id="fm" autocomplete="off">
                <div class="mb-2">
                    <label for="fUser" class="form-label fw-semibold">User</label>
                    <input type="text" id="fUser" class="form-control" maxlength="50" value="@userId" />
                </div>
                <div class="mb-2">
                    <label for="fPwd" class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                    <input type="password" id="fPwd" class="form-control" maxlength="50" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label for="fPwd2" class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                    <input type="password" id="fPwd2" class="form-control" maxlength="50" autocomplete="new-password" />
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-rotate me-1"></i>Reset Password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var byId = function (id) { return document.getElementById(id); };
            byId('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                var p1 = byId('fPwd').value, p2 = byId('fPwd2').value;
                if (!p1 || p1 !== p2) { SD.toast('Password and confirm password does not match', true); return; }
                SD.post('@Url.Action("SaveChangePassword", "UserManagement")', { userId: byId('fUser').value.trim(), password: p1, confirm: p2 })
                    .then(function (res) { SD.toast(res.message, !res.success); if (res.success) { byId('fPwd').value = ''; byId('fPwd2').value = ''; } })
                    .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
