@* Views/UserManagement/RoleSetup.cshtml (old YA: RoleSetup.aspx)
   UC_ROLESETUP add / edit / delete. Priority comes from the chosen parent role (parent priority + 1).
   The list hides the four system roles (ID <= 4), as before. *@
@model AlphaCare.Models.RoleSetupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Role Setup";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-user-gear me-2"></i>Role Setup</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 align-items-end mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                <div class="col-md-3">
                    <label for="fRole" class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
                    <input type="text" id="fRole" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-3">
                    <label for="fDesc" class="form-label fw-semibold">Description</label>
                    <input type="text" id="fDesc" class="form-control" maxlength="150" />
                </div>
                <div class="col-md-3">
                    <label for="fParent" class="form-label fw-semibold">Under (priority) <span class="text-danger">*</span></label>
                    <select id="fParent" class="form-select">
                        @foreach (var o in Model.Parents) { <option value="@o.Value">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Reset</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search role..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all" data-page-size="25">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th class="sortable" data-sort="name">Role<i class="fas fa-sort arr"></i></th>
                                <th>Description</th><th>Created By</th><th>Create Date</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var r = Model.Rows[i];
                                <tr data-search="@(((r.ROLENAME ?? "") + " " + (r.DESCRIPTION ?? "")).ToLower())" data-i="@i"
                                    data-id="@r.ID" data-name="@r.ROLENAME" data-desc="@r.DESCRIPTION" data-parent="@r.PARRENTID"
                                    data-k-name="@((r.ROLENAME ?? "").ToLower())">
                                    <td class="text-center text-muted" data-label="#"><div class="sd-cell">@(i + 1)</div></td>
                                    <td data-label="Role"><div class="sd-cell">@r.ROLENAME</div></td>
                                    <td data-label="Description"><div class="sd-cell">@(string.IsNullOrEmpty(r.DESCRIPTION) ? "-" : r.DESCRIPTION)</div></td>
                                    <td data-label="Created By"><div class="sd-cell">@(r.CREATEDBY ?? "-")</div></td>
                                    <td data-label="Create Date" class="text-nowrap"><div class="sd-cell">@(r.CREATEDATE?.ToString("dd/MM/yyyy") ?? "-")</div></td>
                                    <td class="text-center" data-label="Action">
                                        <div class="sd-cell d-inline-flex gap-1">
                                            <button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button>
                                            <button type="button" class="sd-btn" title="Delete" data-act="del"><i class="fas fa-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Rows.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No role yet.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No role matched your search.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var byId = function (id) { return document.getElementById(id); };
            function reset() { byId('fId').value = '0'; byId('fRole').value = ''; byId('fDesc').value = ''; byId('fSaveText').textContent = 'Save'; }

            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var d = b.closest('tr').dataset;
                    byId('fId').value = d.id; byId('fRole').value = d.name || ''; byId('fDesc').value = d.desc || '';
                    byId('fParent').value = d.parent;
                    byId('fSaveText').textContent = 'Update'; byId('fRole').focus(); window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            document.querySelectorAll('.sd-btn[data-act="del"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    SD.confirm({
                        title: 'Delete this role?', text: b.closest('tr').dataset.name, tone: 'danger', icon: 'fa-trash', yesText: 'Delete',
                        run: function () { return SD.post('@Url.Action("DeleteRole", "UserManagement")', { id: b.closest('tr').dataset.id }); }
                    }).then(function (res) { if (res && res.success) { SD.toast(res.message); setTimeout(function () { location.reload(); }, 700); } });
                });
            });
            byId('fReset').addEventListener('click', reset);
            byId('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                if (!byId('fRole').value.trim()) { SD.toast('Enter the Role name.', true); return; }
                SD.post('@Url.Action("SaveRole", "UserManagement")', {
                    id: byId('fId').value, name: byId('fRole').value.trim(), description: byId('fDesc').value.trim(), parentId: byId('fParent').value
                }).then(function (res) { SD.toast(res.message, !res.success); if (res.success) setTimeout(function () { location.reload(); }, 800); })
                  .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
