@* Views/UserManagement/UserRole.cshtml (old YA: UserRole.aspx)
   Type a staff id -> the user's roles get ticked; Save replaces the user's roles with the ticked ones. *@
@model AlphaCare.Models.UserRoleViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "User Role";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-user-shield me-2"></i>User Role</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            <p class="text-muted small mb-2"><i class="fas fa-circle-info me-1"></i>Type the Staff ID, tick the roles, Save. Saving replaces the user's current roles with the ticked ones.</p>
            @Html.AntiForgeryToken()

            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label for="fStaff" class="form-label fw-semibold">Staff ID <span class="text-danger">*</span></label>
                    <input type="text" id="fStaff" class="form-control" list="dlStaff" maxlength="50" placeholder="Type ID or name" />
                    <datalist id="dlStaff"></datalist>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Employee</label>
                    <input type="text" id="fEmpName" class="form-control" readonly placeholder="-" />
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="button" class="btn btn-primary" id="btnSave"><i class="fas fa-floppy-disk me-1"></i>Save</button>
                    <button type="button" class="btn btn-outline-secondary" id="btnReset"><i class="fas fa-rotate me-1"></i>Reset</button>
                </div>
            </div>

            <div class="sd-wrap table-responsive" style="max-width:640px">
                <table class="sd-table">
                    <thead><tr><th style="width:70px" class="text-center">Select</th><th>Role</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Roles)
                        {
                            <tr>
                                <td class="text-center" data-label="Select"><div class="sd-cell"><input type="checkbox" class="form-check-input role-chk" value="@r.Value" /></div></td>
                                <td data-label="Role"><div class="sd-cell">@r.Text</div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var byId = function (id) { return document.getElementById(id); };
            var t = null;

            byId('fStaff').addEventListener('input', function () {
                clearTimeout(t);
                var q = byId('fStaff').value.trim();
                if (q.length < 2) return;
                t = setTimeout(function () {
                    fetch('@Url.Action("SearchStaff", "UserManagement")?term=' + encodeURIComponent(q), { credentials: 'same-origin' })
                        .then(function (r) { return r.json(); })
                        .then(function (list) { byId('dlStaff').innerHTML = list.map(function (s) { return '<option value="' + SD.esc(s) + '"></option>'; }).join(''); })
                        .catch(function () { });
                }, 250);
            });

            function clearChecks() { document.querySelectorAll('.role-chk').forEach(function (c) { c.checked = false; }); }

            // old tbxUserName_OnTextChanged: load the user's roles and tick them
            byId('fStaff').addEventListener('change', function () {
                var v = byId('fStaff').value.trim();
                if (!v) return;
                fetch('@Url.Action("GetUserRoles", "UserManagement")?staffId=' + encodeURIComponent(v), { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        clearChecks();
                        if (!res.found) { byId('fEmpName').value = ''; SD.toast('Employee not found.', true); return; }
                        byId('fStaff').value = res.staffId;
                        byId('fEmpName').value = res.name || '';
                        (res.roleIds || []).forEach(function (id) {
                            var c = document.querySelector('.role-chk[value="' + id + '"]');
                            if (c) c.checked = true;
                        });
                    }).catch(function () { SD.toast('Could not load the roles.', true); });
            });

            byId('btnReset').addEventListener('click', function () { byId('fStaff').value = ''; byId('fEmpName').value = ''; clearChecks(); });

            byId('btnSave').addEventListener('click', function () {
                var staff = byId('fStaff').value.trim();
                if (!staff) { SD.toast('Enter the Staff ID.', true); return; }
                var ids = Array.prototype.slice.call(document.querySelectorAll('.role-chk:checked')).map(function (c) { return c.value; });
                if (ids.length === 0) { SD.toast('Please select at least one Role!', true); return; }
                var data = { staffId: staff };
                ids.forEach(function (v, i) { data['roleIds[' + i + ']'] = v; });
                SD.post('@Url.Action("SaveUserRoles", "UserManagement")', data)
                    .then(function (res) { SD.toast(res.message, !res.success); })
                    .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
