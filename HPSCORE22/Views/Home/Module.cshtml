@model AlphaCare.Models.ModuleDashboardViewModel

@{
    ViewData["Title"] = Model.Module.MODULENAME;

    // old url style "/Pages/Admin/x.aspx" or "~/Controller/Action" -> app link
    string Href(string? url)
    {
        if (string.IsNullOrWhiteSpace(url) || url == "#") return "#";
        if (url.StartsWith("~")) return Url.Content(url);
        if (url.StartsWith("/")) return Url.Content("~" + url);
        return Url.Content("~/" + url);
    }
    string Ico(string? icon, string fallback)
    {
        if (string.IsNullOrWhiteSpace(icon)) return fallback;
        var i = icon.Trim();
        return i.StartsWith("fa ") || i.StartsWith("fa-") ? "fa " + (i.StartsWith("fa ") ? i.Substring(3) : i) : "fa fa-" + i;
    }

    var groups = Model.Menu;
    int totalItems = groups.Sum(g => g.Children.Count > 0 ? g.Children.Count : 1);
    var palette = new[] { "#4f46e5", "#0891b2", "#d97706", "#7c3aed", "#059669", "#db2777", "#2563eb", "#0d9488" };

    // ===== 4 QUICK MENUS (big tiles under the title) =====
    // Fill this list by hand: (Title, Icon, Url, Color). Url = "~/Controller/Action". Keep 4 items (more/less also works).
    // Example:  ("Gate Entry", "fa-solid fa-flag", "~/Dispatch/GateEntry", "#4f46e5"),
    // While the list is EMPTY, the first 4 items of the user's own menu are shown automatically.
    var manualQuick = new List<(string Title, string Icon, string Url, string Color)>
    {
    };
    var leaves = groups.SelectMany(g => g.Children.Count > 0 ? g.Children : new List<AlphaCare.Models.SideMenuItem> { g })
                       .Where(x => !string.IsNullOrWhiteSpace(x.Url) && x.Url != "#").ToList();
    var quick = manualQuick.Count > 0
        ? manualQuick
        : leaves.Take(4).Select((x, i) => (Title: x.Title, Icon: x.Icon ?? "fa-solid fa-arrow-right", Url: x.Url ?? "#", Color: palette[i % palette.Length])).ToList();
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/v4-shims.min.css" />

<style>
    .md-page {
        --md-primary: #4f46e5;
        --md-text: #1e293b;
        --md-muted: #64748b;
        --md-border: #e8ecf3;
        --md-bg: #f4f6fb;
        font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
        color: var(--md-text);
        background: var(--md-bg);
        padding: 18px 20px 40px;
        min-height: 100%;
    }

        .md-page * {
            box-sizing: border-box;
        }

    .md-crumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .9rem;
        color: var(--md-muted);
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

        .md-crumb a {
            color: var(--md-primary);
            text-decoration: none;
            font-weight: 600;
        }

        .md-crumb b {
            color: var(--md-text);
        }

    /* hero */
    .md-hero {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        padding: 26px 28px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        background: linear-gradient(135deg, #4f46e5, #7c3aed 60%, #06b6d4);
        box-shadow: 0 18px 36px -18px rgba(79,70,229,.7);
        animation: mdRise .5s ease both;
    }

        .md-hero::before, .md-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.1);
        }

        .md-hero::before {
            width: 260px;
            height: 260px;
            right: -80px;
            top: -110px;
        }

        .md-hero::after {
            width: 160px;
            height: 160px;
            left: 38%;
            bottom: -90px;
        }

    .md-hero-left {
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        z-index: 1;
    }

    .md-hero .ico {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        background: rgba(255,255,255,.2);
        display: grid;
        place-items: center;
        font-size: 1.8rem;
    }

    .md-hero h1 {
        margin: 0 0 3px;
        font-size: 1.55rem;
        font-weight: 700;
    }

    .md-hero p {
        margin: 0;
        font-size: .86rem;
        opacity: .9;
    }

    .md-stats {
        display: flex;
        gap: 12px;
        position: relative;
        z-index: 1;
    }

    .md-stat {
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 14px;
        padding: 10px 18px;
        text-align: center;
        min-width: 96px;
    }

        .md-stat b {
            display: block;
            font-size: 1.4rem;
            line-height: 1.1;
        }

        .md-stat span {
            font-size: .7rem;
            letter-spacing: .4px;
            opacity: .9;
        }

    /* toolbar */
    .md-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 20px 0 14px;
        flex-wrap: wrap;
    }

        .md-bar h2 {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 600;
        }

    .md-search {
        position: relative;
        width: 280px;
        max-width: 100%;
    }

        .md-search input {
            width: 100%;
            height: 40px;
            padding: 0 14px 0 40px;
            border: 1.5px solid var(--md-border);
            border-radius: 12px;
            background: #fff;
            font: inherit;
            font-size: .88rem;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

            .md-search input:focus {
                border-color: var(--md-primary);
                box-shadow: 0 0 0 4px rgba(79,70,229,.12);
            }

        .md-search i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: .85rem;
        }

    /* groups */
    .md-groups {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
    }

    .md-card {
        --gc: #4f46e5;
        background: #fff;
        border: 1px solid var(--md-border);
        border-radius: 18px;
        overflow: hidden;
        border-top: 4px solid var(--gc);
        animation: mdRise .5s ease both;
        transition: transform .22s, box-shadow .22s;
    }

        .md-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 28px -16px rgba(30,41,59,.4);
        }

    .md-card-head {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px 8px;
    }

        .md-card-head .gi {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: var(--gc);
            color: #fff;
            display: grid;
            place-items: center;
        }

        .md-card-head h3 {
            margin: 0;
            font-size: .95rem;
            font-weight: 600;
            flex: 1;
        }

        .md-card-head .cnt {
            font-size: .7rem;
            font-weight: 700;
            color: var(--gc);
            background: color-mix(in srgb, var(--gc) 12%, white);
            padding: 3px 10px;
            border-radius: 999px;
        }

    .md-links {
        padding: 4px 10px 12px;
    }

        .md-links a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: 10px;
            color: var(--md-text);
            text-decoration: none;
            font-size: .86rem;
            font-weight: 500;
            transition: background .18s, transform .18s, color .18s;
        }

            .md-links a i.l {
                width: 18px;
                text-align: center;
                color: var(--gc);
                font-size: .82rem;
            }

            .md-links a i.r {
                margin-left: auto;
                font-size: .7rem;
                color: #cbd5e1;
                transition: transform .18s, color .18s;
            }

            .md-links a:hover {
                background: #f1f5f9;
                transform: translateX(4px);
                color: var(--gc);
            }

                .md-links a:hover i.r {
                    color: var(--gc);
                    transform: translateX(3px);
                }

            .md-links a.hide, .md-card.hide {
                display: none;
            }

    .md-empty {
        display: none;
        grid-column: 1 / -1;
        text-align: center;
        color: var(--md-muted);
        padding: 34px;
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 16px;
    }

        .md-empty.show {
            display: block;
        }

    @@keyframes mdRise {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@media (max-width: 768px) {
        .md-hero {
            padding: 20px;
        }

        .md-stats {
            width: 100%;
        }

        .md-stat {
            flex: 1;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .md-page * {
            animation: none !important;
            transition: none !important;
        }
    }

    /* ===== MANAGEMENT DASHBOARD (loaded by AJAX below the quick access) ===== */
    .md-dash-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin: 10px 0 14px;
    }

        .md-dash-head h2 {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 600;
        }

        .md-dash-head small {
            color: var(--md-muted);
            font-size: .76rem;
            margin-left: 8px;
            font-weight: 400;
        }

    .md-btn {
        border: 1.5px solid var(--md-border);
        background: #fff;
        color: var(--md-text);
        border-radius: 10px;
        height: 34px;
        padding: 0 14px;
        font: inherit;
        font-size: .8rem;
        font-weight: 600;
        cursor: pointer;
        transition: .18s;
    }

        .md-btn:hover {
            border-color: var(--md-primary);
            color: var(--md-primary);
        }

        .md-btn.spin i {
            animation: mdSpin .8s linear infinite;
        }

    .md-note {
        display: none;
        margin-bottom: 14px;
        padding: 10px 14px;
        border-radius: 12px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
        font-size: .84rem;
    }

        .md-note.show {
            display: block;
        }

    .md-stat-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 14px;
    }

    .md-sc {
        --sc: #4f46e5;
        display: flex;
        gap: 12px;
        align-items: center;
        background: #fff;
        border: 1px solid var(--md-border);
        border-radius: 16px;
        padding: 14px 16px;
        text-decoration: none;
        color: inherit;
        position: relative;
        overflow: hidden;
        animation: mdRise .45s ease both;
        transition: transform .2s, box-shadow .2s;
    }

        .md-sc::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--sc);
        }

    a.md-sc:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 26px -16px rgba(30,41,59,.45);
        color: inherit;
    }

    .md-sc .si {
        width: 44px;
        height: 44px;
        flex: none;
        border-radius: 13px;
        display: grid;
        place-items: center;
        color: var(--sc);
        font-size: 1.15rem;
        background: color-mix(in srgb, var(--sc) 12%, white);
    }

    .md-sc .sv {
        font-size: 1.55rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .md-sc .st {
        font-size: .78rem;
        font-weight: 600;
        color: var(--md-muted);
    }

    .md-sc .ss {
        font-size: .72rem;
        color: #94a3b8;
        margin-top: 1px;
    }

    .md-chart-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(320px,1fr));
        gap: 16px;
        margin-top: 16px;
    }

    .md-panel {
        background: #fff;
        border: 1px solid var(--md-border);
        border-radius: 18px;
        padding: 16px 18px;
        animation: mdRise .5s ease both;
        min-width: 0;
    }

        .md-panel h3 {
            margin: 0 0 12px;
            font-size: .92rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .md-chart-box {
        position: relative;
        height: 250px;
    }

    .md-empty-s {
        display: none;
        height: 100%;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: .85rem;
    }

    .md-fbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 7px 0;
        font-size: .78rem;
    }
        /* fallback when Chart.js is blocked */
        .md-fbar span.l {
            width: 38%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--md-muted);
        }

        .md-fbar span.b {
            height: 10px;
            border-radius: 6px;
            background: var(--c,#6366f1);
            display: block;
        }

        .md-fbar b {
            font-weight: 600;
        }

    .md-two {
        display: grid;
        grid-template-columns: minmax(0,2fr) minmax(0,1fr);
        gap: 16px;
        margin-top: 16px;
    }

    .md-rec {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 8px;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        transition: background .15s;
    }

        .md-rec:hover {
            background: #f1f5f9;
            color: inherit;
        }

        .md-rec + .md-rec {
            border-top: 1px solid #f1f5f9;
        }

        .md-rec .ri {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            flex: none;
            display: grid;
            place-items: center;
            color: var(--rc);
            background: color-mix(in srgb, var(--rc) 12%, white);
        }

        .md-rec .rt {
            font-weight: 600;
            font-size: .86rem;
            line-height: 1.25;
        }

        .md-rec .rs {
            font-size: .74rem;
            color: var(--md-muted);
        }

        .md-rec .rb {
            margin-left: auto;
            text-align: right;
            flex: none;
        }

    .md-pill {
        display: inline-block;
        font-size: .68rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
        color: var(--rc);
        background: color-mix(in srgb, var(--rc) 13%, white);
    }

    .md-qa {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(130px,1fr));
        gap: 10px;
    }

        .md-qa a {
            --ac: #4f46e5;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
            padding: 14px 8px;
            border-radius: 14px;
            text-align: center;
            text-decoration: none;
            color: var(--md-text);
            font-size: .78rem;
            font-weight: 600;
            border: 1px solid var(--md-border);
            background: #fff;
            transition: transform .18s, box-shadow .18s, border-color .18s;
        }

            .md-qa a i {
                width: 38px;
                height: 38px;
                display: grid;
                place-items: center;
                border-radius: 12px;
                color: #fff;
                background: var(--ac);
            }

            .md-qa a:hover {
                transform: translateY(-3px);
                border-color: var(--ac);
                box-shadow: 0 12px 22px -16px var(--ac);
                color: var(--ac);
            }

    .md-skel {
        background: linear-gradient(90deg,#eef1f6 25%,#f8fafc 37%,#eef1f6 63%);
        background-size: 400% 100%;
        animation: mdShim 1.3s ease infinite;
        border-radius: 16px;
    }

    .md-err {
        text-align: center;
        padding: 26px;
        color: var(--md-muted);
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 16px;
    }

    @@keyframes mdSpin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes mdShim {
        0% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0 50%;
        }
    }

    @@media (max-width: 900px) {
        .md-two {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .md-stat-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width: 480px) {
        .md-chart-grid {
            grid-template-columns: 1fr;
        }

        .md-sc {
            padding: 12px;
            flex-direction: column;
            align-items: flex-start;
        }
    }

    /* ===== v3: compact title bar + quick menu tiles + more interaction ===== */
    .md-hero {
        padding: 10px 18px;
        border-radius: 14px;
        gap: 10px;
        box-shadow: 0 10px 22px -14px rgba(79,70,229,.7);
    }

        .md-hero::before {
            width: 150px;
            height: 150px;
            right: -50px;
            top: -80px;
        }

        .md-hero::after {
            display: none;
        }

        .md-hero .ico {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            font-size: 1.05rem;
        }

    .md-hero-left {
        gap: 12px;
    }

    .md-hero h1 {
        font-size: 1.05rem;
        margin: 0;
        line-height: 1.2;
    }

    .md-hero p {
        font-size: .74rem;
    }

    .md-stat {
        padding: 4px 12px;
        min-width: 0;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .md-stat b {
            display: inline;
            font-size: 1rem;
        }

        .md-stat span {
            font-size: .62rem;
        }

    .md-crumb {
        margin-bottom: 10px;
        font-size: .82rem;
    }

    .md-qm {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 12px;
        margin-top: 14px;
    }

    .md-qt {
        --qc: #4f46e5;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 16px;
        background: #fff;
        border: 1px solid var(--md-border);
        text-decoration: none;
        color: var(--md-text);
        animation: mdRise .5s ease both;
        transition: transform .22s, box-shadow .22s, border-color .22s;
    }

        .md-qt::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: var(--qc);
            transition: width .22s;
        }

        .md-qt::after {
            content: "";
            position: absolute;
            top: 0;
            left: -60%;
            width: 40%;
            height: 100%;
            transform: skewX(-20deg);
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.75), transparent);
            transition: left .6s;
        }

        .md-qt .qi {
            width: 46px;
            height: 46px;
            flex: none;
            display: grid;
            place-items: center;
            border-radius: 14px;
            font-size: 1.2rem;
            color: #fff;
            background: linear-gradient(135deg, var(--qc), color-mix(in srgb, var(--qc) 60%, #000));
            box-shadow: 0 8px 16px -8px var(--qc);
            transition: transform .25s;
        }

        .md-qt .qx {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

            .md-qt .qx b {
                font-size: .92rem;
                font-weight: 600;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .md-qt .qx small {
                font-size: .72rem;
                color: var(--md-muted);
                transition: color .2s;
            }

                .md-qt .qx small i {
                    font-size: .62rem;
                    margin-left: 2px;
                    transition: transform .2s;
                }

        .md-qt:hover {
            transform: translateY(-4px);
            border-color: var(--qc);
            box-shadow: 0 16px 28px -16px var(--qc);
            color: var(--md-text);
        }

            .md-qt:hover::before {
                width: 7px;
            }

            .md-qt:hover::after {
                left: 120%;
            }

            .md-qt:hover .qi {
                transform: rotate(-8deg) scale(1.1);
            }

            .md-qt:hover .qx small {
                color: var(--qc);
            }

                .md-qt:hover .qx small i {
                    transform: translateX(4px);
                }

        .md-qt:active {
            transform: translateY(-1px) scale(.98);
        }

    /* menu cards: click the title to fold / unfold */
    .md-card-head {
        cursor: pointer;
        user-select: none;
    }

        .md-card-head .chv {
            font-size: .7rem;
            color: var(--md-muted);
            transition: transform .25s;
        }

    .md-card.collapsed .chv {
        transform: rotate(-90deg);
    }

    .md-card .md-links {
        max-height: 900px;
        overflow: hidden;
        transition: max-height .3s ease, padding .3s ease, opacity .25s;
    }

    .md-card.collapsed .md-links {
        max-height: 0;
        padding-top: 0;
        padding-bottom: 0;
        opacity: 0;
    }

    .md-search input:focus {
        width: 100%;
    }

    .md-search {
        transition: width .25s;
    }

        .md-search:focus-within {
            width: 340px;
        }

    .md-sc .sv {
        font-variant-numeric: tabular-nums;
    }

    a.md-sc:active, .md-qa a:active {
        transform: scale(.98);
    }

    .md-panel {
        transition: box-shadow .22s, transform .22s;
    }

        .md-panel:hover {
            box-shadow: 0 14px 26px -18px rgba(30,41,59,.4);
        }

    @@media (max-width: 900px) {
        .md-qm {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }
    }

    @@media (max-width: 420px) {
        .md-qt {
            padding: 10px;
            gap: 8px;
        }

            .md-qt .qi {
                width: 38px;
                height: 38px;
            }

        .md-hero p {
            display: none;
        }
    }
</style>

