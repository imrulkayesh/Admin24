<script>
    /* fold / unfold menu cards (remembered), "/" focuses the search box */
    (function () {
        var KEY = 'mdFold_@Model.Module.ID', saved = {};
        try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { }
        var cards = document.querySelectorAll('#mdGroups .md-card');
        function store() { try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) { } }
        function label() {
            var all = document.querySelectorAll('#mdGroups .md-card.collapsed').length === cards.length, b = document.getElementById('mdToggleAll');
            if (b) b.innerHTML = all ? '<i class="fas fa-angles-down"></i> Expand all' : '<i class="fas fa-angles-up"></i> Collapse all';
        }
        cards.forEach(function (c) {
            if (saved[c.dataset.g]) c.classList.add('collapsed');
            c.querySelector('.md-card-head').addEventListener('click', function () {
                c.classList.toggle('collapsed'); saved[c.dataset.g] = c.classList.contains('collapsed') ? 1 : 0; store(); label();
            });
        });
        var all = document.getElementById('mdToggleAll');
        if (all) all.addEventListener('click', function () {
            var collapse = document.querySelectorAll('#mdGroups .md-card.collapsed').length !== cards.length;
            cards.forEach(function (c) { c.classList.toggle('collapsed', collapse); saved[c.dataset.g] = collapse ? 1 : 0; });
            store(); label();
        });
        label();
        document.addEventListener('keydown', function (e) {
            if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test((document.activeElement || {}).tagName || '')) {
                e.preventDefault(); var i = document.getElementById('mdSearch'); if (i) i.focus();
            }
        });
    })();
</script>
<script>
    (function () {
        var input = document.getElementById('mdSearch');
        if (!input) return;
        input.addEventListener('input', function () {
            var q = this.value.trim().toLowerCase(), shown = 0;
            document.querySelectorAll('#mdGroups .md-card').forEach(function (card) {
                var any = false;
                card.querySelectorAll('.md-links a').forEach(function (a) {
                    var ok = !q || a.dataset.t.indexOf(q) !== -1;
                    a.classList.toggle('hide', !ok);
                    if (ok) { any = true; shown++; }
                });
                card.classList.toggle('hide', !any);
                if (q && any) card.classList.remove('collapsed');
            });
            document.getElementById('mdNone').classList.toggle('show', q && shown === 0);
        });
    })();
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js" defer></script>
<script>
    /* Module dashboard: one fetch -> stat cards, charts, recent list, quick actions. Works with or without Chart.js. */
    (function () {
        var box = document.getElementById('mdDash'); if (!box) return;
        var BASE = box.getAttribute('data-url'), DBG = location.search.indexOf('debug=1') >= 0, charts = {}, busy = false;
        function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
        function camel(o) {                                                                        // server may send PascalCase (Program.cs: PropertyNamingPolicy = null) -> make it camelCase
            if (Array.isArray(o)) return o.map(camel);
            if (o && typeof o === 'object') { var r = {}; Object.keys(o).forEach(function (k) { r[k.charAt(0).toLowerCase() + k.slice(1)] = camel(o[k]); }); return r; }
            return o;
        }
        function color(c) { return /^#[0-9a-fA-F]{3,8}$/.test(c || '') ? c : '#4f46e5'; }       // colours come from the server -> accept only hex
        function href(u) { return u && u !== '#' ? ' href="' + esc(u) + '"' : ''; }

        function renderStats(list) {
            document.getElementById('mdStats').innerHTML = list.map(function (s, i) {
                var tag = s.url && s.url !== '#' ? 'a' : 'div';
                return '<' + tag + ' class="md-sc"' + (tag === 'a' ? href(s.url) : '') + ' style="--sc:' + color(s.color) + ';animation-delay:' + (i * 40) + 'ms">' +
                    '<span class="si"><i class="' + esc(s.icon) + '"></i></span><div><div class="sv">' + esc(s.value) + '</div><div class="st">' + esc(s.title) + '</div>' +
                    (s.sub ? '<div class="ss">' + esc(s.sub) + '</div>' : '') + '</div></' + tag + '>';
            }).join('');
            countUp();
        }
        function countUp() {                                                                       // numbers roll up from 0
            if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            document.querySelectorAll('#mdStats .sv').forEach(function (el) {
                var n = Number(el.textContent); if (!isFinite(n) || n <= 0 || n > 100000) return;
                var t0 = performance.now(), dur = 650;
                (function step(t) { var k = Math.min(1, (t - t0) / dur); el.textContent = Math.round(n * (1 - Math.pow(1 - k, 3))); if (k < 1) requestAnimationFrame(step); })(t0);
            });
        }

        function fallbackBars(c, holder) {                                                         // no Chart.js (CDN blocked): simple CSS bars
            var data = c.series[0] ? c.series[0].data : [], max = Math.max.apply(null, data.concat([1]));
            holder.innerHTML = '<div style="max-height:250px;overflow:auto">' + c.labels.map(function (l, i) {
                var col = c.colors[i] || c.colors[0] || '#6366f1';
                return '<div class="md-fbar"><span class="l">' + esc(l) + '</span><span class="b" style="--c:' + color(col) + ';width:' + Math.max(2, data[i] / max * 52) + '%"></span><b>' + data[i] + '</b></div>';
            }).join('') + '</div>';
        }

        function renderCharts(list) {
            if (!window.Chart && document.readyState !== 'complete') {                                // Chart.js (defer) is still downloading
                window.addEventListener('load', function () { renderCharts(list); }, { once: true }); return;
            }
            var wrap = document.getElementById('mdCharts');
            Object.keys(charts).forEach(function (k) { try { charts[k].destroy(); } catch (e) { } }); charts = {};
            wrap.innerHTML = list.map(function (c) {
                return '<div class="md-panel"><h3><i class="fas fa-chart-simple" style="color:#4f46e5"></i>' + esc(c.title) + '</h3><div class="md-chart-box" id="box_' + esc(c.id) + '"><canvas id="cv_' + esc(c.id) + '"></canvas><div class="md-empty-s">No data yet</div></div></div>';
            }).join('');
            list.forEach(function (c) {
                var holder = document.getElementById('box_' + c.id), data = c.series[0] ? c.series[0].data : [];
                if (!data.some(function (v) { return v > 0; })) { holder.querySelector('canvas').style.display = 'none'; holder.querySelector('.md-empty-s').style.display = 'flex'; return; }
                if (!window.Chart) { fallbackBars(c, holder); return; }
                var dn = c.type === 'doughnut', h = c.type === 'hbar', base = color(c.colors[0]);
                var cols = c.colors.length > 1 ? c.colors.map(color) : data.map(function () { return base; });
                charts[c.id] = new Chart(document.getElementById('cv_' + c.id), {
                    type: dn ? 'doughnut' : (c.type === 'line' ? 'line' : 'bar'),
                    data: { labels: c.labels, datasets: c.series.map(function (s) {
                        return { label: s.label, data: s.data, backgroundColor: c.type === 'line' ? base + '33' : cols, borderColor: c.type === 'line' ? base : undefined,
                                 borderWidth: dn ? 2 : (c.type === 'line' ? 2 : 0), borderRadius: dn ? 0 : 6, fill: c.type === 'line', tension: .35, maxBarThickness: 34 };
                    }) },
                    options: {
                        responsive: true, maintainAspectRatio: false, indexAxis: h ? 'y' : 'x', cutout: dn ? '62%' : undefined,
                        plugins: { legend: { display: dn, position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } },
                                   tooltip: { callbacks: { label: function (ctx) { return ' ' + ctx.parsed[dn ? 'x' : (h ? 'x' : 'y')] + (c.unit ? ' ' + c.unit : ''); } } } },
                        scales: dn ? {} : { x: { grid: { display: h }, ticks: { precision: 0 } }, y: { beginAtZero: true, grid: { display: !h }, ticks: { precision: 0 } } }
                    }
                });
            });
        }

        function renderBottom(d) {
            var show = (d.recent && d.recent.length) || (d.actions && d.actions.length);
            document.getElementById('mdBottom').style.display = show ? '' : 'none';
            document.getElementById('mdRecTitle').textContent = d.recentTitle || 'Recent Activities';
            document.getElementById('mdRecent').innerHTML = (d.recent && d.recent.length) ? d.recent.map(function (r) {
                var c = color(r.statusColor);
                return '<a class="md-rec"' + href(r.url) + ' style="--rc:' + c + '"><span class="ri"><i class="' + esc(r.icon) + '"></i></span><div><div class="rt">' + esc(r.title) +
                    '</div><div class="rs">' + esc(r.sub) + '</div></div><div class="rb">' + (r.status ? '<span class="md-pill">' + esc(r.status) + '</span>' : '') +
                    (r.meta ? '<div class="rs" style="margin-top:3px">' + esc(r.meta) + '</div>' : '') + '</div></a>';
            }).join('') : '<div class="md-err" style="border:0">No recent activity.</div>';
            document.getElementById('mdActions').innerHTML = (d.actions || []).map(function (a) {
                return '<a' + href(a.url) + ' style="--ac:' + color(a.color) + '"><i class="' + esc(a.icon) + '"></i>' + esc(a.title) + '</a>';
            }).join('');
        }

        function url(fresh) {                                                                      // /Home/ModuleDashboardData/5 has no '?' yet
            var q = []; if (DBG) q.push('debug=1'); if (fresh) q.push('refresh=1');
            return BASE + (q.length ? (BASE.indexOf('?') < 0 ? '?' : '&') + q.join('&') : '');
        }
        function load(force) {
            if (busy) return; busy = true;
            var btn = document.getElementById('mdRefresh'); btn.classList.add('spin');
            fetch(url(force === true), { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { if (!r.ok) return r.json().catch(function () { return {}; }).then(function (j) { throw new Error(j.detail || j.Detail || r.status); }); return r.json(); })
                .then(function (d) {
                    d = camel(d);
                    renderStats(d.stats || []); renderCharts(d.charts || []); renderBottom(d);
                    var n = document.getElementById('mdNote'); n.textContent = d.note || ''; n.classList.toggle('show', !!d.note);
                    document.getElementById('mdUpdated').textContent = 'Updated ' + (d.updatedAt || '');
                })
                .catch(function (e) {
                    document.getElementById('mdStats').innerHTML = '<div class="md-err" style="grid-column:1/-1"><i class="fas fa-triangle-exclamation"></i> Could not load the dashboard. Press Refresh to try again.' + (isNaN(e.message) ? '<br><small>' + esc(e.message) + '</small>' : '') + '</div>';
                })
                .finally(function () { busy = false; btn.classList.remove('spin'); });
        }
        document.getElementById('mdRefresh').addEventListener('click', function () { load(true); });          // button = fresh numbers
        load();
        setInterval(function () { if (!document.hidden) load(); }, 120000);                         // quiet refresh every 2 minutes
        document.addEventListener('visibilitychange', function () { if (!document.hidden) load(); });
    })();
</script>
