@model AlphaCare.Models.ModuleDashboardViewModel

@{
    ViewData["Title"] = Model.Module.MODULENAME;

    // old url style "/Pages/Admin/x.aspx" or "~/Controller/Action" -> app link
    string Href(string? url)
    {
        if (string.IsNullOrWhiteSpace(url) || url == "#") return "#";
        if (url.StartsWith("~")) return Url.Content(url);
        if (url.StartsWith("/")) return Url.Content("~" + url);
        return Url.Content("~/" + url);
    }
    string Ico(string? icon, string fallback)
    {
        if (string.IsNullOrWhiteSpace(icon)) return fallback;
        var i = icon.Trim();
        return i.StartsWith("fa ") || i.StartsWith("fa-") ? "fa " + (i.StartsWith("fa ") ? i.Substring(3) : i) : "fa fa-" + i;
    }

    var groups = Model.Menu;
    int totalItems = groups.Sum(g => g.Children.Count > 0 ? g.Children.Count : 1);
    var palette = new[] { "#4f46e5", "#0891b2", "#d97706", "#7c3aed", "#059669", "#db2777", "#2563eb", "#0d9488" };
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/v4-shims.min.css" />

<style>
    .md-page {
        --md-primary: #4f46e5;
        --md-text: #1e293b;
        --md-muted: #64748b;
        --md-border: #e8ecf3;
        --md-bg: #f4f6fb;
        font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
        color: var(--md-text);
        background: var(--md-bg);
        padding: 18px 20px 40px;
        min-height: 100%;
    }

        .md-page * {
            box-sizing: border-box;
        }

    .md-crumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .9rem;
        color: var(--md-muted);
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

        .md-crumb a {
            color: var(--md-primary);
            text-decoration: none;
            font-weight: 600;
        }

        .md-crumb b {
            color: var(--md-text);
        }

    /* hero */
    .md-hero {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        padding: 26px 28px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        background: linear-gradient(135deg, #4f46e5, #7c3aed 60%, #06b6d4);
        box-shadow: 0 18px 36px -18px rgba(79,70,229,.7);
        animation: mdRise .5s ease both;
    }

        .md-hero::before, .md-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.1);
        }

        .md-hero::before {
            width: 260px;
            height: 260px;
            right: -80px;
            top: -110px;
        }

        .md-hero::after {
            width: 160px;
            height: 160px;
            left: 38%;
            bottom: -90px;
        }

    .md-hero-left {
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        z-index: 1;
    }

    .md-hero .ico {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        background: rgba(255,255,255,.2);
        display: grid;
        place-items: center;
        font-size: 1.8rem;
    }

    .md-hero h1 {
        margin: 0 0 3px;
        font-size: 1.55rem;
        font-weight: 700;
    }

    .md-hero p {
        margin: 0;
        font-size: .86rem;
        opacity: .9;
    }

    .md-stats {
        display: flex;
        gap: 12px;
        position: relative;
        z-index: 1;
    }

    .md-stat {
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 14px;
        padding: 10px 18px;
        text-align: center;
        min-width: 96px;
    }

        .md-stat b {
            display: block;
            font-size: 1.4rem;
            line-height: 1.1;
        }

        .md-stat span {
            font-size: .7rem;
            letter-spacing: .4px;
            opacity: .9;
        }

    /* toolbar */
    .md-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 20px 0 14px;
        flex-wrap: wrap;
    }

        .md-bar h2 {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 600;
        }

    .md-search {
        position: relative;
        width: 280px;
        max-width: 100%;
    }

        .md-search input {
            width: 100%;
            height: 40px;
            padding: 0 14px 0 40px;
            border: 1.5px solid var(--md-border);
            border-radius: 12px;
            background: #fff;
            font: inherit;
            font-size: .88rem;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

            .md-search input:focus {
                border-color: var(--md-primary);
                box-shadow: 0 0 0 4px rgba(79,70,229,.12);
            }

        .md-search i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: .85rem;
        }

    /* groups */
    .md-groups {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
    }

    .md-card {
        --gc: #4f46e5;
        background: #fff;
        border: 1px solid var(--md-border);
        border-radius: 18px;
        overflow: hidden;
        border-top: 4px solid var(--gc);
        animation: mdRise .5s ease both;
        transition: transform .22s, box-shadow .22s;
    }

        .md-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 28px -16px rgba(30,41,59,.4);
        }

    .md-card-head {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px 8px;
    }

        .md-card-head .gi {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: var(--gc);
            color: #fff;
            display: grid;
            place-items: center;
        }

        .md-card-head h3 {
            margin: 0;
            font-size: .95rem;
            font-weight: 600;
            flex: 1;
        }

        .md-card-head .cnt {
            font-size: .7rem;
            font-weight: 700;
            color: var(--gc);
            background: color-mix(in srgb, var(--gc) 12%, white);
            padding: 3px 10px;
            border-radius: 999px;
        }

    .md-links {
        padding: 4px 10px 12px;
    }

        .md-links a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: 10px;
            color: var(--md-text);
            text-decoration: none;
            font-size: .86rem;
            font-weight: 500;
            transition: background .18s, transform .18s, color .18s;
        }

            .md-links a i.l {
                width: 18px;
                text-align: center;
                color: var(--gc);
                font-size: .82rem;
            }

            .md-links a i.r {
                margin-left: auto;
                font-size: .7rem;
                color: #cbd5e1;
                transition: transform .18s, color .18s;
            }

            .md-links a:hover {
                background: #f1f5f9;
                transform: translateX(4px);
                color: var(--gc);
            }

                .md-links a:hover i.r {
                    color: var(--gc);
                    transform: translateX(3px);
                }

            .md-links a.hide, .md-card.hide {
                display: none;
            }

    .md-empty {
        display: none;
        grid-column: 1 / -1;
        text-align: center;
        color: var(--md-muted);
        padding: 34px;
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 16px;
    }

        .md-empty.show {
            display: block;
        }

    @@keyframes mdRise {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@media (max-width: 768px) {
        .md-hero {
            padding: 20px;
        }

        .md-stats {
            width: 100%;
        }

        .md-stat {
            flex: 1;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .md-page * {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<main class="app-main">
    <div class="app-content">
        <div class="md-page">

            <div class="md-crumb">
                <a href="@Url.Action("Index", "Home")"><i class="fas fa-house"></i> Home</a>
                <span>/</span>
                <a href="@Url.Action("Index", "Home")">Modules</a>
                <span>/</span>
                <b>@Model.Module.MODULENAME</b>
            </div>

            <!-- HERO -->
            <section class="md-hero">
                <div class="md-hero-left">
                    <div class="ico"><i class="@Ico(Model.Module.ICON, "fa fa-folder")"></i></div>
                    <div>
                        <h1>@Model.Module.MODULENAME</h1>
                        <p>Welcome to the @Model.Module.MODULENAME dashboard. Choose a menu from the left sidebar or below.</p>
                    </div>
                </div>
                <div class="md-stats">
                    <div class="md-stat"><b>@groups.Count</b><span>MENU GROUPS</span></div>
                    <div class="md-stat"><b>@totalItems</b><span>MENU ITEMS</span></div>
                </div>
            </section>

            <!-- QUICK ACCESS -->
            <div class="md-bar">
                <h2><i class="fas fa-bolt" style="color:#f59e0b;margin-right:6px"></i>Quick Access</h2>
                <div class="md-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <input type="text" id="mdSearch" placeholder="Search menu..." autocomplete="off" />
                </div>
            </div>

            <div class="md-groups" id="mdGroups">
                @if (groups.Count == 0)
                {
                    <div class="md-empty show"><i class="fas fa-circle-info"></i> No menu found for this module.</div>
                }

                @for (int i = 0; i < groups.Count; i++)
                {
                    var g = groups[i];
                    var color = palette[i % palette.Length];
                    var links = g.Children.Count > 0 ? g.Children : new List<AlphaCare.Models.SideMenuItem> { g };

                    <div class="md-card" style="--gc:@color; animation-delay:@(i * 50)ms">
                        <div class="md-card-head">
                            <span class="gi"><i class="@Ico(g.Icon, "fa-solid fa-folder-open")"></i></span>
                            <h3>@g.Title</h3>
                            <span class="cnt">@links.Count</span>
                        </div>
                        <div class="md-links">
                            @foreach (var c in links)
                            {
                                <a href="@Href(c.Url)" data-t="@c.Title.ToLower()">
                                    <i class="l @Ico(c.Icon, "fa-regular fa-circle")"></i>@c.Title<i class="r fas fa-chevron-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                }

                <div class="md-empty" id="mdNone"><i class="fas fa-magnifying-glass"></i> No menu matched your search.</div>
            </div>

        </div>
    </div>
</main>

<script>
    (function () {
        var input = document.getElementById('mdSearch');
        if (!input) return;
        input.addEventListener('input', function () {
            var q = this.value.trim().toLowerCase(), shown = 0;
            document.querySelectorAll('#mdGroups .md-card').forEach(function (card) {
                var any = false;
                card.querySelectorAll('.md-links a').forEach(function (a) {
                    var ok = !q || a.dataset.t.indexOf(q) !== -1;
                    a.classList.toggle('hide', !ok);
                    if (ok) { any = true; shown++; }
                });
                card.classList.toggle('hide', !any);
            });
            document.getElementById('mdNone').classList.toggle('show', q && shown === 0);
        });
    })();
</script>
