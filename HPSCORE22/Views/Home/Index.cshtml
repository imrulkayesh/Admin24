@* =========================================================================
   SCRIPT  (easy to read - every part has a number)
   [1] settings        [2] DATA you replace later (modules / quick links / notices / events)
   [3] small helpers   [4] module cards   [5] quick links   [6] notice board   [7] upcoming events
   ========================================================================= *@
@section Scripts {
    <script>
        (function () {
            /* [1] ===== SETTINGS - change these ===== */
            var S = {
                NEW_DAYS: 3              // a notice is marked NEW for 3 days
            };

            /* [2] ===== DATA ===== */
            // Modules come from the database (same as old rptModule: ID, MODULENAME, ICON)
            var modules = @Html.Raw(modulesJson);
            var activeId = @Html.Raw(selectedModule);

            var palette = [
                ['#22c55e', '#16a34a'], ['#06b6d4', '#0891b2'], ['#f59e0b', '#d97706'], ['#8b5cf6', '#7c3aed'],
                ['#10b981', '#059669'], ['#ec4899', '#db2777'], ['#3b82f6', '#2563eb'], ['#14b8a6', '#0d9488'],
                ['#f97316', '#ea580c'], ['#6366f1', '#4f46e5'], ['#ef4444', '#dc2626'], ['#84cc16', '#65a30d']
            ];

            // QUICK LINKS:  t1 = small text, t2 = big text, c = colour, u = link, icon = Font Awesome icon
            var quick = [
                { t1: 'Admin Rules',    t2: 'View',   c: '#38bdf8', icon: 'fa-scale-balanced',  u: '#' },
                { t1: 'Service Ticket', t2: 'Create', c: '#38bdf8', icon: 'fa-ticket',          u: '#' },
                { t1: 'Holiday',        t2: 'View',   c: '#ec4899', icon: 'fa-umbrella-beach',  u: '#' },
                { t1: 'Dress Code',     t2: 'View',   c: '#22b8e8', icon: 'fa-shirt',           u: '#' },
                { t1: 'Admin Rules',    t2: 'View',   c: '#2563eb', icon: 'fa-scale-balanced',  u: '#' },
                { t1: 'Service Ticket', t2: 'Create', c: '#f5b324', icon: 'fa-ticket',          u: '#' }
            ];

            // sample dates are "today + N days" so the demo always looks alive.
            // When you use database data, write real dates like  date: '2026-10-20'
            function plusDays(n) { var d = new Date(); d.setDate(d.getDate() + n); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }

            // NOTICES:  title, pri (High / Medium / Low), dept, date (yyyy-mm-dd), text
            var notices = [
                { title: 'IOM Policy Update', pri: 'High', dept: 'HR', date: plusDays(-1),
                  text: 'Please be informed that all IOM and LEAVE Applications must be applied / submitted within 24 hours. These instructions will be effective from the next month.' },
                { title: 'Gatepass Approval Rule', pri: 'Medium', dept: 'Admin', date: plusDays(-4),
                  text: 'All material gatepass must be approved by the department head before dispatch from the factory gate.' },
                { title: 'Office Holiday Notice', pri: 'Low', dept: 'HR', date: plusDays(-9),
                  text: 'Office will remain closed on the upcoming public holiday. Normal operation resumes the next working day.' },
                { title: 'New Dress Code', pri: 'Medium', dept: 'HR', date: plusDays(-12),
                  text: 'Formal dress is required Sunday to Thursday. Casual dress is allowed on Friday only.' }
            ];

            // EVENTS:  date = yyyy-mm-dd, time = HH:mm (24 hour), n = number of people, c = colour
            var events = [
                { date: plusDays(0),  time: '15:00', t: 'Quarterly Town Hall',          loc: 'Auditorium, Level 4', n: 320, c: '#0d9488', info: 'Company results and open question time with management.' },
                { date: plusDays(1),  time: '11:00', t: 'Fire Safety Drill',            loc: 'Factory Floor A',     n: 240, c: '#f59e0b', info: 'Everyone must go to the assembly point when the alarm rings.' },
                { date: plusDays(1),  time: '16:30', t: 'Admin Team Meeting',           loc: 'Meeting Room 2',      n: 12,  c: '#7c3aed', info: 'Weekly review of tickets and gatepass.' },
                { date: plusDays(4),  time: '10:00', t: 'Blood Donation Drive',         loc: 'Reception Lobby',     n: 120, c: '#ef4444', info: 'Please drink enough water and have breakfast before you donate.' },
                { date: plusDays(9),  time: '07:30', t: 'Inter-Department Sports Day',  loc: 'Company Ground',      n: 400, c: '#7c3aed', info: 'Register your department team with the HR desk.' },
                { date: plusDays(16), time: '17:00', t: 'Long Service Award Ceremony',  loc: 'Rooftop Garden',      n: 200, c: '#b45309', info: 'Tea and snacks will be served after the ceremony.' }
            ];

            /* [3] ===== SMALL HELPERS ===== */
            function $(id) { return document.getElementById(id); }
            function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
            function iconClass(ic) { return 'fa ' + String(ic || 'fa-folder').replace(/^fa\s+/, ''); }
            function p2(n) { return String(n).padStart(2, '0'); }
            function store(key, val) {                       // small helper: remember things in this browser
                try { if (val === undefined) return JSON.parse(localStorage.getItem(key)); localStorage.setItem(key, JSON.stringify(val)); } catch (e) { }
                return null;
            }
            var toastTimer;
            function toast(msg, err) {
                var t = $('hmToast'); t.textContent = msg; t.className = 'hm-toast show' + (err ? ' err' : '');
                clearTimeout(toastTimer); toastTimer = setTimeout(function () { t.className = 'hm-toast'; }, 3500);
            }

            /* [4] ===== MODULE CARDS ===== */
            var grid = $('moduleGrid'), pins = store('hmPins') || [], view = store('hmView') || 'grid';
            modules.forEach(function (m, i) { m._i = i; });

            function drawModules() {
                grid.innerHTML = '';
                grid.classList.toggle('list', view === 'list');
                document.querySelectorAll('#viewSeg button').forEach(function (b) { b.classList.toggle('on', b.dataset.view === view); });
                $('modCount').textContent = modules.length;

                if (!modules.length) {
                    grid.innerHTML = '<div class="hm-nomod"><i class="fas fa-folder-open"></i> No module assigned to you.</div>';
                    return;
                }
                // pinned modules first, the rest keep the database order
                var sorted = modules.slice().sort(function (a, b) {
                    var pa = pins.indexOf(a.ID) !== -1 ? 0 : 1, pb = pins.indexOf(b.ID) !== -1 ? 0 : 1;
                    return pa - pb || a._i - b._i;
                });
                sorted.forEach(function (m, idx) {
                    var col = palette[m._i % palette.length], pinned = pins.indexOf(m.ID) !== -1;
                    var d = document.createElement('div');
                    d.className = 'hm-mod' + (m.ID === activeId ? ' active' : '') + (pinned ? ' pinned' : '');
                    d.tabIndex = 0; d.setAttribute('role', 'link');
                    d.dataset.id = m.ID; d.dataset.name = String(m.MODULENAME || '').toLowerCase();
                    d.style.setProperty('--c1', col[0]); d.style.setProperty('--c2', col[1]);
                    d.style.animationDelay = Math.min(idx * 35, 500) + 'ms';
                    d.innerHTML =
                        '<div class="ico"><i class="' + esc(iconClass(m.ICON)) + '"></i></div>' +
                        '<div class="name">' + esc(m.MODULENAME) + '</div>' +
                        '<button type="button" class="pin" title="' + (pinned ? 'Unpin' : 'Pin to top') + '"><i class="' + (pinned ? 'fas' : 'far') + ' fa-star"></i></button>';
                    function go() { d.classList.add('loading'); window.location.href = '@Url.Action("Module", "Home")/' + m.ID; }
                    d.addEventListener('click', go);
                    d.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
                    d.querySelector('.pin').addEventListener('click', function (e) {
                        e.stopPropagation();
                        var at = pins.indexOf(m.ID);
                        if (at === -1) { pins.push(m.ID); toast('Pinned: ' + m.MODULENAME); } else { pins.splice(at, 1); toast('Unpinned: ' + m.MODULENAME); }
                        store('hmPins', pins); drawModules(); filterModules();
                    });
                    grid.appendChild(d);
                });
            }
            function filterModules() {
                var q = $('moduleSearch').value.trim().toLowerCase(), shown = 0;
                grid.querySelectorAll('.hm-mod').forEach(function (b) {
                    var hide = q && b.dataset.name.indexOf(q) === -1;
                    b.classList.toggle('hidden', !!hide); if (!hide) shown++;
                });
                var old = grid.querySelector('.hm-nomatch'); if (old) old.remove();
                if (q && !shown && modules.length) {
                    var n = document.createElement('div'); n.className = 'hm-nomod hm-nomatch';
                    n.innerHTML = '<i class="fas fa-magnifying-glass"></i> No module matched "' + esc(q) + '".'; grid.appendChild(n);
                }
            }
            $('moduleSearch').addEventListener('input', filterModules);
            document.addEventListener('keydown', function (e) {           // press "/" to jump to the search box
                if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) { e.preventDefault(); $('moduleSearch').focus(); }
            });
            document.querySelectorAll('#viewSeg button').forEach(function (b) {
                b.addEventListener('click', function () { view = b.dataset.view; store('hmView', view); drawModules(); filterModules(); });
            });
            drawModules();

            /* [5] ===== QUICK LINKS ===== */
            // one small card for every item of the "quick" list above
            $('quickGrid').innerHTML = quick.map(function (q, i) {
                return '<a class="hm-q" href="' + esc(q.u || '#') + '" style="--qc:' + q.c + ';animation-delay:' + (i * 50) + 'ms">' +
                         '<span class="qico"><i class="fas ' + esc(q.icon || 'fa-circle') + '"></i></span>' +
                         '<span><div class="t1">' + esc(q.t1) + '</div><div class="t2">' + esc(q.t2) + '</div></span>' +
                         '<i class="fas fa-arrow-right go"></i>' +
                       '</a>';
            }).join('');

            /* [6] ===== NOTICE BOARD ===== */
            var MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            var priColor = { High: '#ef4444', Medium: '#f59e0b', Low: '#10b981' };      // stripe colour of each priority

            function toDate(s) { var a = s.split('-'); return new Date(+a[0], +a[1] - 1, +a[2]); }
            function niceDate(s) { var d = toDate(s); return p2(d.getDate()) + ' ' + MON[d.getMonth()] + ' ' + d.getFullYear(); }
            function daysFromToday(s) { var t = new Date(); t.setHours(0, 0, 0, 0); return Math.round((toDate(s) - t) / 864e5); }

            // one card for every notice
            $('noticeList').innerHTML = notices.length ? notices.map(function (n, i) {
                var isNew = -daysFromToday(n.date) <= S.NEW_DAYS;
                return '<div class="hm-n" style="--nc:' + priColor[n.pri] + ';animation-delay:' + (i * 50) + 'ms">' +
                         '<div class="nh"><div>' +
                           '<div class="nt">' + esc(n.title) + '</div>' +
                           '<div class="nm"><span class="hm-pri">' + esc(n.pri) + '</span>' +
                           '<span><i class="fas fa-users"></i> ' + esc(n.dept) + '</span>' +
                           '<span><i class="far fa-clock"></i> ' + niceDate(n.date) + '</span>' + (isNew ? '<span class="hm-new">NEW</span>' : '') + '</div>' +
                         '</div><i class="fas fa-chevron-down chev"></i></div>' +
                         '<div class="nb">' + esc(n.text) + '</div>' +
                       '</div>';
            }).join('') : '<div class="hm-empty"><i class="far fa-bell-slash"></i>No notice.</div>';

            // click a notice = open / close its text
            $('noticeList').addEventListener('click', function (e) {
                var box = e.target.closest('.hm-n'); if (!box) return;
                var wasOpen = box.classList.contains('open');
                this.querySelectorAll('.hm-n.open').forEach(function (x) { x.classList.remove('open'); });
                box.classList.toggle('open', !wasOpen);
            });

            /* [7] ===== UPCOMING EVENTS ===== */
            function clock(t) { var a = t.split(':'), h = +a[0]; return p2(h % 12 || 12) + ':' + a[1] + ' ' + (h >= 12 ? 'PM' : 'AM'); }
            function whenText(days) { return days === 0 ? 'Today' : days === 1 ? 'Tomorrow' : 'In ' + days + ' days'; }

            // only today and the coming days, nearest first
            var coming = events.filter(function (e) { return daysFromToday(e.date) >= 0; })
                               .sort(function (x, y) { return (x.date + x.time).localeCompare(y.date + y.time); });

            $('eventList').innerHTML = coming.length ? coming.map(function (e, i) {
                var days = daysFromToday(e.date);
                return '<div class="hm-te' + (days === 0 ? ' today' : '') + '" style="--ec:' + e.c + ';animation-delay:' + (i * 50) + 'ms">' +
                         '<div class="tm"><b>' + clock(e.time) + '</b><small>' + whenText(days) + '</small></div>' +
                         '<div class="rail"><i></i></div>' +
                         '<div class="card"><h6>' + esc(e.t) + '</h6>' +
                           '<div class="meta"><span><i class="far fa-calendar"></i>' + niceDate(e.date) + '</span>' +
                           '<span><i class="fas fa-location-dot"></i>' + esc(e.loc) + '</span><span><i class="fas fa-user-group"></i>' + e.n + '</span></div>' +
                           '<div class="more"><p>' + esc(e.info || '') + '</p></div>' +
                         '</div></div>';
            }).join('') : '<div class="hm-empty"><i class="far fa-calendar-xmark"></i>No upcoming event.</div>';

            // click an event = open / close its details
            $('eventList').addEventListener('click', function (e) {
                var card = e.target.closest('.card'); if (!card) return;
                var wasOpen = card.classList.contains('open');
                this.querySelectorAll('.card.open').forEach(function (x) { x.classList.remove('open'); });
                card.classList.toggle('open', !wasOpen);
            });
        })();
    </script>
}
