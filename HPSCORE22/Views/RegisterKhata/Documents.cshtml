@* Views/RegisterKhata/Documents.cshtml  (old YA: Pages/RegisterKhata/Documents.aspx)
   Register of a location: add / edit (delete was switched off in YA). Changing the location reloads its list (old AutoPostBack);
   while an entry is being edited the location only changes the entry. Standard look: app-standard.css / app-standard.js. *@
@model AlphaCare.Models.RkRegisterPageModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Documents";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-file-import me-2"></i>Documents</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                    <div class="col-md-3">
                        <label for="fLocation" class="form-label fw-semibold">Location <span class="text-danger">*</span></label>
                        <select id="fLocation" class="form-select">
                            @foreach (var c in Model.Locations)
                            {
                                <option value="@c.ID" selected="@(c.ID == Model.LocationId)">@c.CENTERNAME</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="f_documentName" class="form-label fw-semibold">Document Name <span class="text-danger">*</span></label>
                        <input type="text" id="f_documentName" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-3">
                        <label for="f_senderName" class="form-label fw-semibold">Sender Name <span class="text-danger">*</span></label>
                        <input type="text" id="f_senderName" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-3">
                        <label for="f_senderMobile" class="form-label fw-semibold">Sender Mobile <span class="text-danger">*</span></label>
                        <input type="text" id="f_senderMobile" class="form-control" inputmode="numeric" maxlength="20" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                    </div>
                    <div class="col-md-3">
                        <label for="f_receiverName" class="form-label fw-semibold">Receiver Name <span class="text-danger">*</span></label>
                        <input type="text" id="f_receiverName" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-3">
                        <label for="f_receiverMobile" class="form-label fw-semibold">Receiver Mobile <span class="text-danger">*</span></label>
                        <input type="text" id="f_receiverMobile" class="form-control" inputmode="numeric" maxlength="20" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                    </div>
                    <div class="col-md-3">
                        <label for="f_transport" class="form-label fw-semibold">Transport <span class="text-danger">*</span></label>
                        <input type="text" id="f_transport" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-3">
                        <label for="f_inDate" class="form-label fw-semibold">In Date</label>
                        <input type="date" id="f_inDate" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label for="f_inTime" class="form-label fw-semibold">In Time</label>
                        <input type="text" id="f_inTime" class="form-control" maxlength="50" placeholder="Enter In Time" />
                    </div>
                    <div class="col-md-3">
                        <label for="f_outDate" class="form-label fw-semibold">Out Date</label>
                        <input type="date" id="f_outDate" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label for="f_outTime" class="form-label fw-semibold">Out Time</label>
                        <input type="text" id="f_outTime" class="form-control" maxlength="50" placeholder="Enter Out Time" />
                    </div>
                    <div class="col-12">
                        <label for="f_remarks" class="form-label fw-semibold">Remarks</label>
                        <textarea id="f_remarks" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Reset</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search document, sender, receiver..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all" data-page-size="25">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">Action</th>
                                <th class="sortable text-nowrap" data-sort="c0">Document<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c1">Sender<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c2">Sender Mobile<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c3">Receiver<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c4">Receiver Mobile<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c5">Transport<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c6">In Date<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c7">In Time<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c8">Out Date<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c9">Out Time<i class="fas fa-sort arr"></i></th>
                                <th class="sortable text-nowrap" data-sort="c10">Remarks<i class="fas fa-sort arr"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var x in Model.Documents)
                            {
                                <tr data-search="@($"{x.DOCUMENTNAME} {x.SENDERNAME} {x.SENDERMOBILE} {x.RECEIVERNAME} {x.RECEIVERMOBILE} {x.TRANSPORT} {x.INTIME} {x.OUTTIME} {x.REMARKS}".ToLower())" data-i="@(idx++)" data-id="@x.ID" data-k-c0="@((x.DOCUMENTNAME ?? "").ToLower())" data-k-c1="@((x.SENDERNAME ?? "").ToLower())" data-k-c2="@((x.SENDERMOBILE ?? "").ToLower())" data-k-c3="@((x.RECEIVERNAME ?? "").ToLower())" data-k-c4="@((x.RECEIVERMOBILE ?? "").ToLower())" data-k-c5="@((x.TRANSPORT ?? "").ToLower())" data-k-c6="@(x.INDATE?.Ticks ?? 0)" data-k-c7="@((x.INTIME ?? "").ToLower())" data-k-c8="@(x.OUTDATE?.Ticks ?? 0)" data-k-c9="@((x.OUTTIME ?? "").ToLower())" data-k-c10="@((x.REMARKS ?? "").ToLower())">
                                    <td class="text-center" data-label="Action"><div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div></td>
                                    <td data-label="Document"><div class="sd-cell">@(string.IsNullOrWhiteSpace(x.DOCUMENTNAME) ? "-" : x.DOCUMENTNAME)</div></td>
                                    <td data-label="Sender"><div class="sd-cell">@(string.IsNullOrWhiteSpace(x.SENDERNAME) ? "-" : x.SENDERNAME)</div></td>
                                    <td data-label="Sender Mobile" class="text-nowrap"><div class="sd-cell">@(string.IsNullOrWhiteSpace(x.SENDERMOBILE) ? "-" : x.SENDERMOBILE)</div></td>
                                    <td data-label="Receiver"><div class="sd-cell">@(string.IsNullOrWhiteSpace(x.RECEIVERNAME) ? "-" : x.RECEIVERNAME)</div></td>
                                    <td data-label="Receiver Mobile" class="text-nowrap"><div class="sd-cell">@(string.IsNullOrWhiteSpace(x.RECEIVERMOBILE) ? "-" : x.RECEIVERMOBILE)</div></td>
                                    <td data-label="Transport"><div class="sd-cell">@(string.IsNullOrWhiteSpace(x.TRANSPORT) ? "-" : x.TRANSPORT)</div></td>
                                    <td data-label="In Date" class="text-nowrap"><div class="sd-cell">@(x.INDATE?.ToString("dd/MM/yyyy") ?? "-")</div></td>
                                    <td data-label="In Time" class="text-nowrap"><div class="sd-cell">@(string.IsNullOrWhiteSpace(x.INTIME) ? "-" : x.INTIME)</div></td>
                                    <td data-label="Out Date" class="text-nowrap"><div class="sd-cell">@(x.OUTDATE?.ToString("dd/MM/yyyy") ?? "-")</div></td>
                                    <td data-label="Out Time" class="text-nowrap"><div class="sd-cell">@(string.IsNullOrWhiteSpace(x.OUTTIME) ? "-" : x.OUTTIME)</div></td>
                                    <td data-label="Remarks"><div class="sd-cell">@(string.IsNullOrWhiteSpace(x.REMARKS) ? "-" : x.REMARKS)</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Documents.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No document entry for this location.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No entry matched your filter.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var byId = function (id) { return document.getElementById(id); };
            var J = window.jQuery;
            var U = { page: '@Url.Action("Documents", "RegisterKhata")', get: '@Url.Action("GetDocument", "RegisterKhata")', save: '@Url.Action("SaveDocument", "RegisterKhata")' };
            var fields = ['documentName', 'senderName', 'senderMobile', 'receiverName', 'receiverMobile', 'transport', 'inDate', 'inTime', 'outDate', 'outTime', 'remarks'];
            // drop downs may be Select2 (app-standard.js): refresh the visible box after setting a value
            function setSel(el, v) { el.value = v; if (J) J(el).trigger('change.select2'); }
            function editing() { return byId('fId').value !== '0'; }

            function reset() {
                byId('fId').value = '0';
                fields.forEach(function (f) { var el = byId('f_' + f); if (el.tagName === 'SELECT') setSel(el, '0'); else el.value = ''; });
                byId('fSaveText').textContent = 'Save';
            }
            function check() {
                if (!byId('f_documentName').value.trim()) return 'Enter Document Name';
                if (!byId('f_senderName').value.trim()) return 'Enter Sender Name';
                if (!byId('f_senderMobile').value.trim()) return 'Enter Sender Mobile';
                if (!byId('f_receiverName').value.trim()) return 'Enter Receiver Name';
                if (!byId('f_receiverMobile').value.trim()) return 'Enter Receiver Mobile';
                if (!byId('f_transport').value.trim()) return 'Enter Transport';
                return null;
            }

            // old ddlLocation AutoPostBack: a new location shows its list (not while an entry is being edited)
            var onLoc = function () { if (!editing()) location.href = U.page + '?locationId=' + encodeURIComponent(byId('fLocation').value); };
            if (J) J(byId('fLocation')).on('change', onLoc); else byId('fLocation').addEventListener('change', onLoc);

            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    fetch(U.get + '?id=' + encodeURIComponent(b.closest('tr').dataset.id), { credentials: 'same-origin' })
                        .then(function (r) { return r.json(); })
                        .then(function (res) {
                            if (!res.success) { SD.toast(res.message, true); return; }
                            var x = res.row;
                            byId('fId').value = x.id;
                            setSel(byId('fLocation'), x.locationId);
                            fields.forEach(function (f) {
                                var el = byId('f_' + f), v = x[f];
                                if (el.tagName === 'SELECT') setSel(el, v || '0'); else el.value = (v === null || v === undefined) ? '' : v;
                            });
                            byId('fSaveText').textContent = 'Update';
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        }).catch(function () { SD.toast('Server error. Please try again.', true); });
                });
            });

            byId('fReset').addEventListener('click', reset);
            byId('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                var err = check(); if (err) { SD.toast(err, true); return; }
                var data = { Id: byId('fId').value, LocationId: byId('fLocation').value };
                fields.forEach(function (f) { data[f.charAt(0).toUpperCase() + f.slice(1)] = byId('f_' + f).value; });
                var btn = e.submitter || byId('fm').querySelector('button[type="submit"]'), html = btn.innerHTML;
                SD.lock(btn, editing() ? 'Updating...' : 'Saving...');
                SD.post(U.save, data).then(function (res) {
                    SD.toast(res.message, !res.success);
                    if (res.success) setTimeout(function () { location.href = U.page + '?locationId=' + encodeURIComponent(byId('fLocation').value); }, 800);
                    else { btn.disabled = false; btn.innerHTML = html; }
                }).catch(function () { btn.disabled = false; btn.innerHTML = html; SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
