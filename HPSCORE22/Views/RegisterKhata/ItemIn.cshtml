@* Views/RegisterKhata/ItemIn.cshtml  (old YA: Pages/RegisterKhata/ItemIn.aspx)
   Stock in for the user's warehouse: item (code + unit come from Item Master), quantity, price, validity date.
   Save adds the quantity to the item stock. Edit (as YA) changes quantity and price only; the stock is corrected by the difference. *@
@model AlphaCare.Models.RkStorePageModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Item In";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-dolly me-2"></i>Item In</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @Html.AntiForgeryToken()

            @if (Model.Warehouses.Count == 0)
            {
                <div class="alert alert-warning py-2"><i class="fas fa-triangle-exclamation me-1"></i>You have no warehouse at this location. Ask an administrator to set it on Warehouse Permission.</div>
            }

            <form id="fm" class="row g-2 mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="0" />
                <div class="col-md-3">
                    <label for="fCenter" class="form-label fw-semibold">Business Center <span class="text-danger">*</span></label>
                    <select id="fCenter" class="form-select">
                        @foreach (var c in Model.Locations)
                        {
                            <option value="@c.ID" selected="@(c.ID == Model.CenterId)">@c.CENTERNAME</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fWarehouse" class="form-label fw-semibold">Warehouse <span class="text-danger">*</span></label>
                    <select id="fWarehouse" class="form-select">
                        @foreach (var w in Model.Warehouses)
                        {
                            <option value="@w.ID" selected="@(w.ID == Model.WarehouseId)">@w.NAME</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fItem" class="form-label fw-semibold">Item Name <span class="text-danger">*</span></label>
                    <select id="fItem" class="form-select">
                        <option value="0">Select</option>
                        @foreach (var i in Model.Items)
                        {
                            <option value="@i.ID">@i.NAME</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-1">
                    <label for="fCode" class="form-label fw-semibold">Item Code</label>
                    <input type="text" id="fCode" class="form-control" readonly />
                </div>
                <div class="col-6 col-md-2">
                    <label for="fUnitName" class="form-label fw-semibold">Unit</label>
                    <input type="text" id="fUnitName" class="form-control" readonly />
                </div>
                <div class="col-6 col-md-2">
                    <label for="fQty" class="form-label fw-semibold">Quantity <span class="text-danger">*</span></label>
                    <input type="text" id="fQty" class="form-control" inputmode="decimal" />
                </div>
                <div class="col-6 col-md-2">
                    <label for="fPrice" class="form-label fw-semibold">Price</label>
                    <input type="text" id="fPrice" class="form-control" inputmode="decimal" />
                </div>
                <div class="col-md-3">
                    <label for="fValid" class="form-label fw-semibold">Validity Date</label>
                    <input type="date" id="fValid" class="form-control" />
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@(Model.WarehouseId == 0)"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">Save</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Reset</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search item, code..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all" data-page-size="25">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">Action</th>
                                <th>Warehouse</th>
                                <th class="sortable" data-sort="name">Item Name<i class="fas fa-sort arr"></i></th>
                                <th class="sortable" data-sort="code">Item Code<i class="fas fa-sort arr"></i></th>
                                <th class="text-end">Quantity</th>
                                <th>Unit</th>
                                <th class="text-end">Price</th>
                                <th class="sortable" data-sort="valid">Validity Date<i class="fas fa-sort arr"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var x in Model.ItemInRows)
                            {
                                <tr data-search="@($"{x.ITEMNAME} {x.ITEMCODE} {x.UNITNAME}".ToLower())" data-i="@(idx++)"
                                    data-k-name="@((x.ITEMNAME ?? "").ToLower())" data-k-code="@((x.ITEMCODE ?? "").ToLower())" data-k-valid="@(x.VALIDITYDATE?.Ticks ?? 0)"
                                    data-id="@x.ID" data-item="@x.ITEMID" data-code="@x.ITEMCODE" data-unit="@x.UNITNAME"
                                    data-qty="@(x.QUANTITY?.ToString(System.Globalization.CultureInfo.InvariantCulture))" data-price="@(x.PRICE?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                    data-valid="@(x.VALIDITYDATE?.ToString("yyyy-MM-dd"))">
                                    <td class="text-center" data-label="Action"><div class="sd-cell"><button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button></div></td>
                                    <td data-label="Warehouse"><div class="sd-cell">@x.WAREHOUSENAME</div></td>
                                    <td data-label="Item Name"><div class="sd-cell">@x.ITEMNAME</div></td>
                                    <td data-label="Item Code"><div class="sd-cell">@x.ITEMCODE</div></td>
                                    <td data-label="Quantity" class="text-end"><div class="sd-cell">@((x.QUANTITY ?? 0).ToString("#,0.##"))</div></td>
                                    <td data-label="Unit"><div class="sd-cell">@x.UNITNAME</div></td>
                                    <td data-label="Price" class="text-end"><div class="sd-cell">@(x.PRICE?.ToString("#,0.##") ?? "-")</div></td>
                                    <td data-label="Validity Date" class="text-nowrap"><div class="sd-cell">@(x.VALIDITYDATE?.ToString("dd/MM/yyyy") ?? "-")</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.ItemInRows.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No stock in for this warehouse.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No entry matched your filter.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var byId = function (id) { return document.getElementById(id); };
            var J = window.jQuery;
            var page = '@Url.Action("ItemIn", "RegisterKhata")', infoUrl = '@Url.Action("ItemInfo", "RegisterKhata")';
            function on(el, fn) { if (J) J(el).on('change', fn); else el.addEventListener('change', fn); }
            function setSel(el, v) { el.value = v; if (J) J(el).trigger('change.select2'); }
            function lock(edit) { byId('fItem').disabled = edit; byId('fWarehouse').disabled = edit; byId('fCenter').disabled = edit; byId('fValid').disabled = edit; }
            function reset() {
                byId('fId').value = '0'; setSel(byId('fItem'), '0');
                ['fCode', 'fUnitName', 'fQty', 'fPrice', 'fValid'].forEach(function (f) { byId(f).value = ''; });
                lock(false); byId('fSaveText').textContent = 'Save';
            }

            on(byId('fCenter'), function () { location.href = page + '?centerId=' + encodeURIComponent(byId('fCenter').value); });
            on(byId('fWarehouse'), function () { location.href = page + '?centerId=' + encodeURIComponent(byId('fCenter').value) + '&warehouseId=' + encodeURIComponent(byId('fWarehouse').value); });
            // old ddlItemName_OnSelectedIndexChanged: code + unit of the item
            on(byId('fItem'), function () {
                byId('fCode').value = ''; byId('fUnitName').value = '';
                if (byId('fItem').value === '0' || byId('fId').value !== '0') return;
                fetch(infoUrl + '?itemId=' + encodeURIComponent(byId('fItem').value), { credentials: 'same-origin' }).then(function (r) { return r.json(); })
                    .then(function (x) { if (x.found) { byId('fCode').value = x.itemCode || ''; byId('fUnitName').value = x.unitName || ''; } })
                    .catch(function () { });
            });

            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var d = b.closest('tr').dataset;
                    byId('fId').value = d.id; setSel(byId('fItem'), d.item || '0');
                    byId('fCode').value = d.code || ''; byId('fUnitName').value = d.unit || '';
                    byId('fQty').value = d.qty || ''; byId('fPrice').value = d.price || ''; byId('fValid').value = d.valid || '';
                    lock(true); byId('fSaveText').textContent = 'Update'; window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            byId('fReset').addEventListener('click', reset);
            byId('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                var isEdit = byId('fId').value !== '0';
                if (!isEdit && byId('fItem').value === '0') { SD.toast('Select Item Name', true); return; }
                if (!byId('fQty').value.trim()) { SD.toast('Enter Item Quantity', true); return; }
                var btn = e.submitter || byId('fm').querySelector('button[type="submit"]'), html = btn.innerHTML;
                SD.lock(btn, isEdit ? 'Updating...' : 'Saving...');
                SD.post('@Url.Action("SaveItemIn", "RegisterKhata")', {
                    id: byId('fId').value, warehouseId: byId('fWarehouse').value, itemId: byId('fItem').value,
                    quantity: byId('fQty').value.trim(), price: byId('fPrice').value.trim(), validityDate: byId('fValid').value
                }).then(function (res) {
                    SD.toast(res.message, !res.success);
                    if (res.success) setTimeout(function () { location.reload(); }, 800); else { btn.disabled = false; btn.innerHTML = html; }
                }).catch(function () { btn.disabled = false; btn.innerHTML = html; SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
