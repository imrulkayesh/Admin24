@* Views/Admin/DepartmentAssign.cshtml (old YA: Pages/Admin/DepartmentAssign.aspx)
   Which departments a company runs at a business center: pick Company + Country > Location > Business Center,
   tick the departments, Save (old rule: saving replaces the pair's previous assignment). *@
@model AlphaCare.Models.DepartmentAssignViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Department Assign";
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas fa-people-arrows me-2"></i>Department Assign</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            <p class="text-muted small mb-2"><i class="fas fa-circle-info me-1"></i>Tick the departments of the selected company at the selected business center. Saving replaces the previous assignment of this company + center.</p>
            @Html.AntiForgeryToken()

            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-3">
                    <label for="fCompany" class="form-label fw-semibold">Company <span class="text-danger">*</span></label>
                    <select id="fCompany" class="form-select">
                        @foreach (var o in Model.Companies) { <option value="@o.Value" selected="@(o.Value == Model.CompanyId.ToString())">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fCountry" class="form-label fw-semibold">Country</label>
                    <select id="fCountry" class="form-select">
                        @foreach (var o in Model.Countries) { <option value="@o.Value" selected="@(o.Value == Model.CountryId.ToString())">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fLocation" class="form-label fw-semibold">Location</label>
                    <select id="fLocation" class="form-select">
                        @foreach (var o in Model.Locations) { <option value="@o.Value" selected="@(o.Value == Model.LocationId.ToString())">@o.Text</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fCenter" class="form-label fw-semibold">Business Center <span class="text-danger">*</span></label>
                    <select id="fCenter" class="form-select">
                        @foreach (var o in Model.Centers) { <option value="@o.Value" selected="@(o.Value == Model.CenterId.ToString())">@o.Text</option> }
                    </select>
                </div>
            </div>

            @if (!Model.Loaded)
            {
                <div class="alert alert-warning py-2"><i class="fas fa-circle-exclamation me-1"></i>Select the Company and the Business Center to load the assignment.</div>
            }

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search department or code..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
            </div>

            <div class="sd-pane active" id="pane-all" data-page-size="50">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th style="width:60px" class="text-center">
                                    <input type="checkbox" id="chkAll" class="form-check-input" title="Select all" />
                                </th>
                                <th>Department</th>
                                <th>Code</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Departments.Count; i++)
                            {
                                var d = Model.Departments[i];
                                <tr data-search="@(((d.DEPARTMENTNAME ?? "") + " " + (d.DEPARTMENTCODE ?? "")).ToLower())" data-i="@i">
                                    <td class="text-center" data-label="Assign">
                                        <div class="sd-cell"><input type="checkbox" class="form-check-input dep-chk" value="@d.ID" checked="@d.Assigned" /></div>
                                    </td>
                                    <td data-label="Department"><div class="sd-cell">@d.DEPARTMENTNAME</div></td>
                                    <td data-label="Code"><div class="sd-cell">@(string.IsNullOrEmpty(d.DEPARTMENTCODE) ? "-" : d.DEPARTMENTCODE)</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Departments.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No department yet.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No department matched your search.</div>
            </div>

            <div class="mt-3">
                <button type="button" class="btn btn-primary" id="btnSave" @(Model.Loaded ? "" : "disabled")><i class="fas fa-floppy-disk me-1"></i>Save Assignment</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var byId = function (id) { return document.getElementById(id); };
            var pageUrl = '@Url.Action("DepartmentAssign", "Admin")';

            function reload() {
                location.href = pageUrl + '?companyId=' + byId('fCompany').value + '&countryId=' + byId('fCountry').value +
                    '&locationId=' + byId('fLocation').value + '&centerId=' + byId('fCenter').value;
            }
            ['fCompany', 'fCountry', 'fLocation', 'fCenter'].forEach(function (id) {
                byId(id).addEventListener('change', reload);
            });

            // ticks only the rows that match the current search (every page of them); ticked hidden rows stay ticked
            var all = byId('chkAll');
            if (all) all.addEventListener('change', function () {
                document.querySelectorAll('.dep-chk').forEach(function (c) {
                    if (c.closest('tr').style.display !== 'none') c.checked = all.checked;
                });
            });

            byId('btnSave').addEventListener('click', function () {
                var ids = Array.prototype.slice.call(document.querySelectorAll('.dep-chk:checked')).map(function (c) { return c.value; });
                var data = { companyId: byId('fCompany').value, centerId: byId('fCenter').value };
                ids.forEach(function (v, i) { data['departmentIds[' + i + ']'] = v; });
                SD.post('@Url.Action("SaveDepartmentAssign", "Admin")', data)
                    .then(function (res) { SD.toast(res.message, !res.success); if (res.success) setTimeout(reload, 700); })
                    .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
