@* Views/Admin/Setup.cshtml - ONE page for every simple Admin setup screen (old YA Pages/Admin/*.aspx).
   The controller's SetupDef says which inputs, cascades and grid columns the page has.
   Dropdown changes and Edit reload the page with GET parameters (like the old AutoPostBack);
   Save / Delete post JSON (SD.post), like the dispatch setup pages. *@
@model AlphaCare.Models.AdminSetupViewModel
@using AlphaCare.Models

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Title;
    string val(string key) => Model.Values.TryGetValue(key, out var v) ? v : "";
    string text(object? v, string kind) => v switch
    {
        null => "",
        DateTime dt when kind == "day" => dt.ToString("dd/MM/yyyy"),
        DateTime dt => dt.ToString("dd/MM/yyyy hh:mm tt"),
        decimal m => m.ToString("0.##"),
        double x => x.ToString("0.##"),
        _ => Convert.ToString(v) ?? ""
    };
    // the GET query that keeps the cascade selection when the page reloads
    var selects = Model.Fields.Where(f => f.Kind == "select").ToList();
}

<div class="sd-page" data-smart-page>
    <div class="card shadow-sm border-0">
        <div class="sd-head">
            <h5 class="mb-0"><i class="fas @Model.Icon me-2"></i>@Model.Title</h5>
            <span class="sd-date"><i class="far fa-calendar me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <p class="text-muted small mb-2"><i class="fas fa-circle-info me-1"></i>@Model.Note</p>
            }
            @if (TempData["msg"] is string msg && !string.IsNullOrEmpty(msg))
            {
                <div class="alert alert-warning py-2"><i class="fas fa-circle-exclamation me-1"></i>@msg</div>
            }
            @Html.AntiForgeryToken()

            <form id="fm" class="row g-2 align-items-end mb-3" autocomplete="off">
                <input type="hidden" id="fId" value="@Model.EditId" />
                @foreach (var f in Model.Fields)
                {
                    <div class="col-md-3">
                        <label for="f_@f.Key" class="form-label fw-semibold">@f.Label @if (f.Required) { <span class="text-danger">*</span> }</label>
                        @if (f.Kind == "select")
                        {
                            <select id="f_@f.Key" name="@f.Key" class="form-select" data-cascade="@(f.Parent ?? "")">
                                @foreach (var o in Model.Options.TryGetValue(f.Key, out var opts) ? opts : new List<SetupOption>())
                                {
                                    <option value="@o.Value" selected="@(o.Value == val(f.Key))">@o.Text</option>
                                }
                            </select>
                        }
                        else if (f.Kind == "date")
                        {
                            <input type="date" id="f_@f.Key" name="@f.Key" class="form-control" value="@val(f.Key)" />
                        }
                        else if (f.Kind == "int")
                        {
                            <input type="text" id="f_@f.Key" name="@f.Key" class="form-control" inputmode="numeric" maxlength="9" value="@val(f.Key)" />
                        }
                        else
                        {
                            <input type="text" id="f_@f.Key" name="@f.Key" class="form-control" maxlength="@f.MaxLen" value="@val(f.Key)" />
                        }
                    </div>
                }
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i><span id="fSaveText">@(Model.EditId > 0 ? "Update" : "Save")</span></button>
                    <button type="button" class="btn btn-outline-secondary" id="fReset"><i class="fas fa-rotate me-1"></i>Reset</button>
                </div>
            </form>

            <div class="sd-tools">
                <div class="input-group grow">
                    <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="sdSearch" placeholder="Search in the list..." autocomplete="off" />
                </div>
                <button type="button" class="sd-link" id="sdClear" style="display:none"><i class="fas fa-xmark me-1"></i>Clear filters</button>
                <button type="button" class="sd-link" id="sdResetSort" style="display:none"><i class="fas fa-arrow-rotate-left me-1"></i>Default order</button>
            </div>

            <div class="sd-pane active" id="pane-all" data-page-size="25">
                <div class="sd-wrap table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                @for (int c = 0; c < Model.Columns.Count; c++)
                                {
                                    <th class="sortable text-nowrap" data-sort="c@(c)">@Model.Columns[c].Header<i class="fas fa-sort arr"></i></th>
                                }
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];
                                var cells = Model.Columns.Select(col => { row.TryGetValue(col.Key, out var v); return v; }).ToList();
                                string search = string.Join(" ", cells.Select((v, k) => text(v, Model.Columns[k].Kind))).ToLowerInvariant();
                                row.TryGetValue("ID", out var idObj);
                                string keys = string.Join(" ", cells.Select((v, c) => $"data-k-c{c}=\"{System.Text.Encodings.Web.HtmlEncoder.Default.Encode(text(v, Model.Columns[c].Kind).ToLowerInvariant())}\""));
                                <tr data-search="@search" data-i="@i" data-id="@idObj" @Html.Raw(keys)>
                                    <td class="text-center text-muted" data-label="#"><div class="sd-cell">@(i + 1)</div></td>
                                    @for (int c = 0; c < cells.Count; c++)
                                    {
                                        var col = Model.Columns[c];
                                        string t = text(cells[c], col.Kind);
                                        <td data-label="@col.Header" class="@(col.Kind is "date" or "day" ? "text-nowrap" : "") @(col.Kind == "num" ? "text-end" : "")">
                                            <div class="sd-cell">@(t.Length == 0 ? "-" : t)</div>
                                        </td>
                                    }
                                    <td class="text-center" data-label="Action">
                                        <div class="sd-cell d-inline-flex gap-1">
                                            <button type="button" class="sd-btn" title="Edit" data-act="edit"><i class="fas fa-pen"></i></button>
                                            @if (Model.CanDelete)
                                            {
                                                <button type="button" class="sd-btn danger" title="Delete" data-act="del"><i class="fas fa-trash"></i></button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sd-empty" data-empty="all" style="@(Model.Rows.Count == 0 ? "" : "display:none")"><i class="far fa-folder-open"></i> No data yet.</div>
                <div class="sd-empty" data-empty="filter" style="display:none"><i class="fas fa-filter-circle-xmark"></i> No row matched your search.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            SD.initList();
            var byId = function (id) { return document.getElementById(id); };
            var pageUrl = '@Url.Action(Model.Key, "Admin")';
            var selectKeys = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selects.Select(s => s.Key)));

            // keep the cascade selections in the URL (old AutoPostBack: changing a dropdown reloads its children + grid)
            function reload(extra) {
                var q = [];
                selectKeys.forEach(function (k) {
                    var el = byId('f_' + k);
                    if (el && el.value) q.push(encodeURIComponent(k) + '=' + encodeURIComponent(el.value));
                });
                if (extra) q.push(extra);
                location.href = pageUrl + (q.length ? '?' + q.join('&') : '');
            }
            selectKeys.forEach(function (k) {
                var el = byId('f_' + k);
                if (el) el.addEventListener('change', function () { reload(); });
            });

            document.querySelectorAll('.sd-btn[data-act="edit"]').forEach(function (b) {
                b.addEventListener('click', function () { location.href = pageUrl + '?edit=' + b.closest('tr').dataset.id; });
            });
            document.querySelectorAll('.sd-btn[data-act="del"]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var id = b.closest('tr').dataset.id;
                    SD.confirm({
                        title: 'Delete this record?', text: 'This cannot be undone.', tone: 'danger', icon: 'fa-trash', yesText: 'Delete',
                        run: function () { return SD.post('@Url.Action("DeleteSetup", "Admin")', { key: '@Model.Key', id: id }); }
                    }).then(function (res) { if (res && res.success) { SD.toast(res.message); setTimeout(reload, 700); } });
                });
            });

            byId('fReset').addEventListener('click', function () { reload(); });
            byId('fm').addEventListener('submit', function (e) {
                e.preventDefault();
                var data = { key: '@Model.Key', id: byId('fId').value || 0 };
                document.querySelectorAll('#fm [name]').forEach(function (el) { data[el.name] = el.value; });
                SD.post('@Url.Action("SaveSetup", "Admin")', data)
                    .then(function (res) { SD.toast(res.message, !res.success); if (res.success) setTimeout(function () { reload(); }, 700); })
                    .catch(function () { SD.toast('Server error. Please try again.', true); });
            });
        })();
    </script>
}
